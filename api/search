726":10,"727":10,"728":11,"729":11,"730":11,"731":10,"732":10,"733":10,"734":10,"735":7,"736":7,"737":10,"738":10,"739":7,"740":7,"741":7,"742":7,"743":4,"744":4,"745":5,"746":5,"747":5,"748":6,"749":7,"750":5,"751":4,"752":4,"753":5,"754":5,"755":5,"756":5,"757":5,"758":5,"759":5,"760":5,"761":5,"762":5,"763":5,"764":5,"765":5,"766":5,"767":5,"768":5,"769":5,"770":5,"771":5,"772":5,"773":5,"774":5,"775":5,"776":5,"777":5,"778":5,"779":5,"780":6,"781":6,"782":6,"783":6,"784":6,"785":6,"786":6,"787":6,"788":6,"789":6,"790":6,"791":6,"792":7,"793":7,"794":7,"795":7,"796":7,"797":5,"798":5,"799":4,"800":4,"801":6,"802":7,"803":6,"804":7,"805":8,"806":5,"807":5,"808":4,"809":6,"810":6,"811":6,"812":6,"813":7,"814":7,"815":6,"816":6,"817":6,"818":6,"819":7,"820":8,"821":8,"822":8,"823":5,"824":5}}},"docs":{"docs":{"1":{"id":"/docs/architecture","page_id":"/docs/architecture","type":"page","content":"Architecture","breadcrumbs":["Brokspace","Reference"],"tags":[],"url":"/docs/architecture","locale":"en"},"2":{"id":"/docs/architecture-0","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture","content":"This document explains how the pieces of Brokspace fit together.","locale":"en"},"3":{"id":"/docs/architecture-1","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#crates-and-repositories","content":"Crates and repositories","locale":"en"},"4":{"id":"/docs/architecture-2","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#workspace-layout","content":"Workspace layout","locale":"en"},"5":{"id":"/docs/architecture-3","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#indexing-pipeline","content":"Indexing pipeline","locale":"en"},"6":{"id":"/docs/architecture-4","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#stores","content":"Stores","locale":"en"},"7":{"id":"/docs/architecture-5","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#search","content":"Search","locale":"en"},"8":{"id":"/docs/architecture-6","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#event-bus","content":"Event bus","locale":"en"},"9":{"id":"/docs/architecture-7","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#built-in-participants","content":"Built-in participants","locale":"en"},"10":{"id":"/docs/architecture-8","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#well-known-topics","content":"Well-known topics","locale":"en"},"11":{"id":"/docs/architecture-9","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#daemon-lifecycle","content":"Daemon lifecycle","locale":"en"},"12":{"id":"/docs/architecture-10","page_id":"/docs/architecture","type":"heading","tags":[],"url":"/docs/architecture#memory-profile","content":"Memory profile","locale":"en"},"13":{"id":"/docs/architecture-11","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture","content":"This document explains how the pieces of Brokspace fit together. It is aimed\nat contributors and shard authors.","locale":"en"},"14":{"id":"/docs/architecture-12","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#crates-and-repositories","content":"Rules of thumb: library crates use `thiserror`/`anyhow::Result` with context\nand never print; only `brok-cli` talks to the terminal. Optional native\nbackends are cargo features, so the pure-Rust build always works.","locale":"en"},"15":{"id":"/docs/architecture-13","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#indexing-pipeline","content":"**Walk** with the `ignore` crate (nested `.gitignore`s, global excludes),\nthen apply `index.include` / `index.exclude`.","locale":"en"},"16":{"id":"/docs/architecture-14","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#indexing-pipeline","content":"**Route** each file to the deepest partition containing it\n(`PartitionMap::resolve`).","locale":"en"},"17":{"id":"/docs/architecture-15","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#indexing-pipeline","content":"**Skip unchanged files** cheaply: same size and mtime as in `files.json` →\nuntouched; otherwise hash the content and compare.","locale":"en"},"18":{"id":"/docs/architecture-16","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#indexing-pipeline","content":"**Chunk** in parallel (rayon). The AST chunker emits one chunk per\ndefinition, attaches doc comments/attributes/decorators, splits large\ncontainers into a header plus members (`parent` = the container) and\ngroups loose top-level code into `preamble` chunks.","locale":"en"},"19":{"id":"/docs/architecture-17","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#indexing-pipeline","content":"**Embed** in batches on a blocking thread (`spawn_blocking`), prefixing\n`search_document:` as nomic models expect; mean pooling → layer norm →\nMatryoshka truncation → L2 normalization.","locale":"en"},"20":{"id":"/docs/architecture-18","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#indexing-pipeline","content":"**Write**: delete the file's previous chunks, append the new ones, update\nBM25 and the manifest, then commit atomically. Files are processed in\nbatches of 512 so memory stays bounded on large repositories.","locale":"en"},"21":{"id":"/docs/architecture-19","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#indexing-pipeline","content":"`brok index` and `brok run` take an exclusive OS file lock on\n`databases/.lock`; readers (`brok search`, `brok status`) never block.","locale":"en"},"22":{"id":"/docs/architecture-20","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#stores","content":"Both stores share one Arrow schema (`brok-index/src/schema.rs`): `id`, `path`,\n`language`, `kind`, `symbol`, `parent`, `signature`, line and byte ranges,\n`file_hash`, `content` and an optional `FixedSizeList<Float32>` `vector`.","locale":"en"},"23":{"id":"/docs/architecture-21","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#stores","content":"**LanceDB**: deletes/appends go straight to the table; compaction runs every\n16 writes and an ANN index is built past 10 000 rows.","locale":"en"},"24":{"id":"/docs/architecture-22","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#stores","content":"**Arrow IPC**: each commit writes a new immutable generation file and flips\n`CURRENT`. Files are memory-mapped and decoded zero-copy; immutability is\nwhat makes `mmap` sound and lets readers keep an old generation (Windows\ncannot replace a mapped file). Vector search is exact (dot product over\nnormalized vectors).","locale":"en"},"25":{"id":"/docs/architecture-23","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#search","content":"For each partition: BM25 top-k and vector top-k (when the partition has\nvectors of the right size) → Reciprocal Rank Fusion (`k = 60`), normalized so\nthat rank 1 in every list scores 1.0. Partitions other than the focus (the\npartition of the current directory) are multiplied by `search.cold_weight`.\nThe final top-k chunk ids are materialized from their stores.","locale":"en"},"26":{"id":"/docs/architecture-24","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#event-bus","content":"**Transport**: Unix domain socket at `.brokspace/run/brok.sock` (falls back\nto `$XDG_RUNTIME_DIR` for long paths) or the named pipe\n`\\\\.\\pipe\\brok-<hash of the workspace path>`. Frames are a 4-byte big-endian\nlength plus JSON, capped at 16 MiB.","locale":"en"},"27":{"id":"/docs/architecture-25","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#event-bus","content":"**Handshake**: `Hello{protocol, name, version, token}` → `Welcome{session,\nidentity, context}` or `Error`. Tokens are 256-bit random, stored hashed.","locale":"en"},"28":{"id":"/docs/architecture-26","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#event-bus","content":"**Router**: a single actor task owns all state, so routing is lock-free.\nDelivery uses bounded queues and `try_send`: a slow client loses events (and\nis logged) rather than stalling everyone.","locale":"en"},"29":{"id":"/docs/architecture-27","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#event-bus","content":"**Semantics**: topic patterns (`file:*`), `source` stamped by the bus,\n`system:*` reserved and broadcast, request/reply via `correlation_id` routed\nonly to the requester (a bounded table with a 15 minute TTL).","locale":"en"},"30":{"id":"/docs/architecture-28","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#built-in-participants","content":"| Participant                                 | Identity   | Publishes            | Subscribes |\n| ------------------------------------------- | ---------- | -------------------- | ---------- |\n| CLI (`brok ask`, `brok bus`, `brok search`) | `operator` | any non-system topic | `*`        |","locale":"en","table":"table-0"},"31":{"id":"/docs/architecture-29","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#built-in-participants","content":"| Participant   | Identity     | Publishes | Subscribes                     |\n| ------------- | ------------ | --------- | ------------------------------ |\n| Index service | `brok-index` | `index:*` | `file:changed`, `index:search` |","locale":"en","table":"table-0"},"32":{"id":"/docs/architecture-30","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#built-in-participants","content":"| Participant | Identity            | Publishes      | Subscribes      |\n| ----------- | ------------------- | -------------- | --------------- |\n| Shards      | their manifest name | `publishes_to` | `subscribes_to` |","locale":"en","table":"table-0"},"33":{"id":"/docs/architecture-31","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#well-known-topics","content":"| Topic          | Payload                              | Direction                  |\n| -------------- | ------------------------------------ | -------------------------- |\n| `file:changed` | `{changed: [path], deleted: [path]}` | agent → index (and anyone) |","locale":"en","table":"table-1"},"34":{"id":"/docs/architecture-32","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#well-known-topics","content":"| Topic                                  | Payload                           | Direction     |\n| -------------------------------------- | --------------------------------- | ------------- |\n| `index:search` / `index:search.result` | `SearchRequest` / `SearchResults` | request/reply |","locale":"en","table":"table-1"},"35":{"id":"/docs/architecture-33","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#well-known-topics","content":"| Topic           | Payload             | Direction      |\n| --------------- | ------------------- | -------------- |\n| `index:updated` | counts and duration | index → anyone |","locale":"en","table":"table-1"},"36":{"id":"/docs/architecture-34","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#well-known-topics","content":"| Topic       | Payload                                | Direction   |\n| ----------- | -------------------------------------- | ----------- |\n| `agent:ask` | `{prompt, provider?, context_chunks?}` | CLI → agent |","locale":"en","table":"table-1"},"37":{"id":"/docs/architecture-35","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#well-known-topics","content":"| Topic                                  | Payload        | Direction         |\n| -------------------------------------- | -------------- | ----------------- |\n| `agent:ask.chunk` / `.done` / `.error` | streamed reply | agent → requester |","locale":"en","table":"table-1"},"38":{"id":"/docs/architecture-36","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#well-known-topics","content":"| Topic           | Payload                    | Direction      |\n| --------------- | -------------------------- | -------------- |\n| `review:result` | `{path, verdict, summary}` | agent → anyone |","locale":"en","table":"table-1"},"39":{"id":"/docs/architecture-37","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#well-known-topics","content":"| Topic             | Payload    | Direction          |\n| ----------------- | ---------- | ------------------ |\n| `system:shutdown` | `{reason}` | runtime → everyone |","locale":"en","table":"table-1"},"40":{"id":"/docs/architecture-38","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#well-known-topics","content":"Types live in `brok_sdk::payload`.","locale":"en"},"41":{"id":"/docs/architecture-39","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#daemon-lifecycle","content":"`brok run` is the daemon in the foreground; `brok start` launches the same\nprocess detached (output in `.brokspace/logs/brok.log`), and `brok ask`,\n`chat`, `review`, `commit` and `skill run` start it on demand. Readiness means\nthe bus is listening and, when installed, `brok-agent` is connected; the CLI\nchecks it with a `daemon:status` request.","locale":"en"},"42":{"id":"/docs/architecture-40","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#daemon-lifecycle","content":"Start: bind the bus → issue the operator token (`run/operator.token`) → start\nthe control service (`daemon:status`, `daemon:stop`) → open the index for\nwriting (falls back to read-only search if the model or lock is unavailable),\ncatch up on changes made while stopped, and connect the index service → for\neach enabled shard, issue a token from its manifest, build its sandbox\nenvironment and supervise it.","locale":"en"},"43":{"id":"/docs/architecture-41","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#daemon-lifecycle","content":"Stop (Ctrl+C, or `brok stop` publishing `daemon:stop`): broadcast\n`system:shutdown` → shards get 3 seconds to exit, then are killed → index\nservice stops → bus stops → runtime files removed.","locale":"en"},"44":{"id":"/docs/architecture-42","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#daemon-lifecycle","content":"Freshness: `brok-agent` reports dirty files every few seconds and, when a\nrepository's `HEAD` moves (commit, pull, checkout), the files that differ\nbetween the two commits; root, submodules and nested repositories alike.","locale":"en"},"45":{"id":"/docs/architecture-43","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#daemon-lifecycle","content":"Crashing shards restart with exponential backoff (1 s … 30 s); five crashes\nwithin a minute and the supervisor gives up.","locale":"en"},"46":{"id":"/docs/architecture-44","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#memory-profile","content":"Text-only search (embeddings disabled or model missing): BM25 postings in\nmemory plus memory-mapped chunk data; typically a few tens of MB.","locale":"en"},"47":{"id":"/docs/architecture-45","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#memory-profile","content":"Semantic search loads the quantized model (~140 MB of weights) once per\nprocess. Run `brok run` and searches reuse its already-loaded model through\nthe bus instead of loading their own.","locale":"en"},"48":{"id":"/docs/architecture-46","page_id":"/docs/architecture","tags":[],"type":"text","url":"/docs/architecture#memory-profile","content":"Indexing streams files in batches; the Arrow store keeps staged batches in\nmemory until commit, LanceDB writes per batch.","locale":"en"},"49":{"id":"/docs/configuration","page_id":"/docs/configuration","type":"page","content":"Configuration reference","breadcrumbs":["Brokspace","Reference"],"tags":[],"url":"/docs/configuration","locale":"en"},"50":{"id":"/docs/configuration-0","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration","content":"Changes take effect on the next command (or after restarting brok run).","locale":"en"},"51":{"id":"/docs/configuration-1","page_id":"/docs/configuration","type":"heading","tags":[],"url":"/docs/configuration#workspace","content":"`workspace`","locale":"en"},"52":{"id":"/docs/configuration-2","page_id":"/docs/configuration","type":"heading","tags":[],"url":"/docs/configuration#index","content":"`index`","locale":"en"},"53":{"id":"/docs/configuration-3","page_id":"/docs/configuration","type":"heading","tags":[],"url":"/docs/configuration#embeddings","content":"`embeddings`","locale":"en"},"54":{"id":"/docs/configuration-4","page_id":"/docs/configuration","type":"heading","tags":[],"url":"/docs/configuration#user-defaults","content":"User defaults","locale":"en"},"55":{"id":"/docs/configuration-5","page_id":"/docs/configuration","type":"heading","tags":[],"url":"/docs/configuration#search","content":"`search`","locale":"en"},"56":{"id":"/docs/configuration-6","page_id":"/docs/configuration","type":"heading","tags":[],"url":"/docs/configuration#llm","content":"`llm`","locale":"en"},"57":{"id":"/docs/configuration-7","page_id":"/docs/configuration","type":"heading","tags":[],"url":"/docs/configuration#sync","content":"`sync`","locale":"en"},"58":{"id":"/docs/configuration-8","page_id":"/docs/configuration","type":"heading","tags":[],"url":"/docs/configuration#shards","content":"`shards`","locale":"en"},"59":{"id":"/docs/configuration-9","page_id":"/docs/configuration","type":"heading","tags":[],"url":"/docs/configuration#environment-variables","content":"Environment variables","locale":"en"},"60":{"id":"/docs/configuration-10","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration","content":"`brok init` writes `.brokspace/brok.yml` with comments (commands that change\nthe file, like `brok setup llm`, keep them; comments you add yourself are\ndropped when brok rewrites the file). Every key is optional;\nmissing keys take the defaults below. Unknown keys are rejected with a\n\"did you mean\" style error, so typos never go unnoticed.","locale":"en"},"61":{"id":"/docs/configuration-11","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration","content":"Changes take effect on the next command (or after restarting `brok run`).\nChanging `embeddings.model`, `embeddings.dimensions` or `index.store`\ntriggers a rebuild of the affected partitions on the next `brok index`.","locale":"en"},"62":{"id":"/docs/configuration-12","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#workspace","content":"| Key          | Default | Description                                                                                                                                 |\n| ------------ | ------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `submodules` | `true`  | Index git submodules and git repositories nested in the workspace (up to 4 levels, e.g. a folder of repos) as independent _hot_ partitions. |","locale":"en","table":"table-0"},"63":{"id":"/docs/configuration-13","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#index","content":"| Key       | Default    | Description                                               |\n| --------- | ---------- | --------------------------------------------------------- |\n| `include` | `[\"**/*\"]` | Globs (relative to the workspace root) of files to index. |","locale":"en","table":"table-1"},"64":{"id":"/docs/configuration-14","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#index","content":"| Key       | Default                                                                                                                                                                    | Description                                                          |\n| --------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | -------------------------------------------------------------------- |\n| `exclude` | `.git`, `.brokspace`, `target`, `node_modules`, `dist`, `build`, lock files (`*.lock`, `pnpm-lock.yaml`, `package-lock.json`, `npm-shrinkwrap.json`, `go.sum`), `*.min.js` | Globs to skip. `.gitignore` files are always honored on top of this. |","locale":"en","table":"table-1"},"65":{"id":"/docs/configuration-15","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#index","content":"| Key           | Default | Description                                                                                |\n| ------------- | ------- | ------------------------------------------------------------------------------------------ |\n| `max_file_kb` | `512`   | Larger files are skipped. Binary files (NUL bytes) and non UTF-8 files are always skipped. |","locale":"en","table":"table-1"},"66":{"id":"/docs/configuration-16","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#index","content":"| Key               | Default | Description                                                                                          |\n| ----------------- | ------- | ---------------------------------------------------------------------------------------------------- |\n| `max_chunk_lines` | `120`   | A syntactic unit longer than this is split: containers into members, other nodes at line boundaries. |","locale":"en","table":"table-1"},"67":{"id":"/docs/configuration-17","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#index","content":"| Key     | Default | Description                                                                                             |\n| ------- | ------- | ------------------------------------------------------------------------------------------------------- |\n| `store` | `auto`  | `auto` (LanceDB when compiled in), `lancedb` or `arrow` (memory-mapped Arrow IPC, exact vector search). |","locale":"en","table":"table-1"},"68":{"id":"/docs/configuration-18","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#embeddings","content":"| Key       | Default | Description                                                         |\n| --------- | ------- | ------------------------------------------------------------------- |\n| `enabled` | `true`  | `false` runs on BM25 text search only: no download, minimal memory. |","locale":"en","table":"table-2"},"69":{"id":"/docs/configuration-19","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#embeddings","content":"| Key     | Default                 | Description                     |\n| ------- | ----------------------- | ------------------------------- |\n| `model` | `nomic-embed-text-v1.5` | The only supported model today. |","locale":"en","table":"table-2"},"70":{"id":"/docs/configuration-20","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#embeddings","content":"| Key       | Default     | Description                                            |\n| --------- | ----------- | ------------------------------------------------------ |\n| `variant` | `quantized` | `quantized` (~140 MB, int8) or `full` (~550 MB, fp32). |","locale":"en","table":"table-2"},"71":{"id":"/docs/configuration-21","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#embeddings","content":"| Key          | Default | Description                                                |\n| ------------ | ------- | ---------------------------------------------------------- |\n| `dimensions` | `768`   | Matryoshka truncation: `64`, `128`, `256`, `512` or `768`. |","locale":"en","table":"table-2"},"72":{"id":"/docs/configuration-22","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#embeddings","content":"| Key      | Default | Description                                                                                |\n| -------- | ------- | ------------------------------------------------------------------------------------------ |\n| `device` | `auto`  | `auto`, `cpu`, `cuda`, `coreml`, `directml` (GPU devices need the matching build feature). |","locale":"en","table":"table-2"},"73":{"id":"/docs/configuration-23","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#embeddings","content":"| Key          | Default | Description                |\n| ------------ | ------- | -------------------------- |\n| `batch_size` | `16`    | Texts per inference batch. |","locale":"en","table":"table-2"},"74":{"id":"/docs/configuration-24","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#embeddings","content":"Model files are downloaded once per user and shared by every workspace:\n`~/.cache/brokspace/models` (Linux), `~/Library/Caches/brokspace/models`\n(macOS), `%LOCALAPPDATA%\\brokspace\\models` (Windows). Set `BROK_MODELS_DIR`\nto use another directory. A copy inside `.brokspace/cache/models/` (from\nolder versions) keeps working.","locale":"en"},"75":{"id":"/docs/configuration-25","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#user-defaults","content":"`brok setup llm` also stores your LLM choice in the user configuration\n(`~/.config/brokspace/config.yml`, `~/Library/Application Support/brokspace/`\nor `%APPDATA%\\brokspace\\`; override with `BROK_CONFIG_DIR`). `brok init`\napplies it to every new workspace, so you choose a model once per machine.","locale":"en"},"76":{"id":"/docs/configuration-26","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#search","content":"| Key     | Default | Description                |\n| ------- | ------- | -------------------------- |\n| `limit` | `8`     | Default number of results. |","locale":"en","table":"table-3"},"77":{"id":"/docs/configuration-27","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#search","content":"| Key           | Default | Description                                                                  |\n| ------------- | ------- | ---------------------------------------------------------------------------- |\n| `cold_weight` | `0.85`  | Score multiplier for partitions other than the one you run the command from. |","locale":"en","table":"table-3"},"78":{"id":"/docs/configuration-28","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#llm","content":"OpenAI-compatible chat completion endpoints used by `brok-agent`.","locale":"en"},"79":{"id":"/docs/configuration-29","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#llm","content":"| Key       | Description                                                                           |\n| --------- | ------------------------------------------------------------------------------------- |\n| `default` | Provider used unless `brok ask --provider` says otherwise. Must exist in `providers`. |","locale":"en","table":"table-4"},"80":{"id":"/docs/configuration-30","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#llm","content":"| Key                         | Description                    |\n| --------------------------- | ------------------------------ |\n| `providers.<name>.base_url` | URL up to and including `/v1`. |","locale":"en","table":"table-4"},"81":{"id":"/docs/configuration-31","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#llm","content":"| Key                      | Description                            |\n| ------------------------ | -------------------------------------- |\n| `providers.<name>.model` | Model name as the provider expects it. |","locale":"en","table":"table-4"},"82":{"id":"/docs/configuration-32","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#llm","content":"| Key                            | Description                                                                       |\n| ------------------------------ | --------------------------------------------------------------------------------- |\n| `providers.<name>.api_key_env` | **Name** of the environment variable holding the key. Keys never go in this file. |","locale":"en","table":"table-4"},"83":{"id":"/docs/configuration-33","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#llm","content":"| Key                                           | Description                 |\n| --------------------------------------------- | --------------------------- |\n| `providers.<name>.temperature` / `max_tokens` | Optional sampling settings. |","locale":"en","table":"table-4"},"84":{"id":"/docs/configuration-34","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#sync","content":"Where the index is mirrored, configured with `brok setup sync`.","locale":"en"},"85":{"id":"/docs/configuration-35","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#sync","content":"| Key       | Description                               |\n| --------- | ----------------------------------------- |\n| `backend` | `none`, `s3`, `r2`, `minio` or `git-lfs`. |","locale":"en","table":"table-5"},"86":{"id":"/docs/configuration-36","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#sync","content":"| Key                                                | Description                 |\n| -------------------------------------------------- | --------------------------- |\n| `remote.bucket` / `prefix` / `region` / `endpoint` | Object storage coordinates. |","locale":"en","table":"table-5"},"87":{"id":"/docs/configuration-37","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#sync","content":"| Key                                        | Description                                                                                             |\n| ------------------------------------------ | ------------------------------------------------------------------------------------------------------- |\n| `remote.access_key_env` / `secret_key_env` | Names of the variables holding the credentials (default `AWS_ACCESS_KEY_ID` / `AWS_SECRET_ACCESS_KEY`). |","locale":"en","table":"table-5"},"88":{"id":"/docs/configuration-38","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#sync","content":"`git-lfs` tracks `.brokspace/databases/**` with Git LFS and stops ignoring it,\nso the index travels with the repository. The object storage sync engine\n(`brok sync`) is on the roadmap: today `brok setup sync` records the target.","locale":"en"},"89":{"id":"/docs/configuration-39","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#shards","content":"Each shard documents its own `settings`. For `brok-agent` see its\nREADME.","locale":"en"},"90":{"id":"/docs/configuration-40","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#environment-variables","content":"| Variable   | Used by | Purpose                                       |\n| ---------- | ------- | --------------------------------------------- |\n| `RUST_LOG` | all     | Log filter, e.g. `RUST_LOG=brok_index=debug`. |","locale":"en","table":"table-6"},"91":{"id":"/docs/configuration-41","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#environment-variables","content":"| Variable   | Used by | Purpose         |\n| ---------- | ------- | --------------- |\n| `NO_COLOR` | CLI     | Disable colors. |","locale":"en","table":"table-6"},"92":{"id":"/docs/configuration-42","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#environment-variables","content":"| Variable          | Used by | Purpose                                                  |\n| ----------------- | ------- | -------------------------------------------------------- |\n| `BROK_MODELS_DIR` | CLI     | Embedding model cache (default: the OS cache directory). |","locale":"en","table":"table-6"},"93":{"id":"/docs/configuration-43","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#environment-variables","content":"| Variable          | Used by | Purpose                                                     |\n| ----------------- | ------- | ----------------------------------------------------------- |\n| `BROK_CONFIG_DIR` | CLI     | User defaults directory (default: the OS config directory). |","locale":"en","table":"table-6"},"94":{"id":"/docs/configuration-44","page_id":"/docs/configuration","tags":[],"type":"text","url":"/docs/configuration#environment-variables","content":"| Variable          | Used by | Purpose                                          |\n| ----------------- | ------- | ------------------------------------------------ |\n| `BROK_*` (others) | shards  | Set by `brok run` for shard processes; reserved. |","locale":"en","table":"table-6"},"95":{"id":"/docs/getting-started","page_id":"/docs/getting-started","type":"page","content":"Getting started with Brokspace","breadcrumbs":["Brokspace","Start"],"tags":[],"url":"/docs/getting-started","locale":"en"},"96":{"id":"/docs/getting-started-0","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"From zero to a productive workspace in about 15 minutes.","locale":"en"},"97":{"id":"/docs/getting-started-1","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#1-install-brok","content":"1. Install brok","locale":"en"},"98":{"id":"/docs/getting-started-2","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#2-get-a-local-llm-optional","content":"2. Get a local LLM (optional)","locale":"en"},"99":{"id":"/docs/getting-started-3","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#3-set-up-your-first-workspace","content":"3. Set up your first workspace","locale":"en"},"100":{"id":"/docs/getting-started-4","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#4-use-it-every-day","content":"4. Use it every day","locale":"en"},"101":{"id":"/docs/getting-started-5","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#5-connect-your-coding-agent","content":"5. Connect your coding agent","locale":"en"},"102":{"id":"/docs/getting-started-6","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#6-configure","content":"6. Configure","locale":"en"},"103":{"id":"/docs/getting-started-7","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#7-skills","content":"7. Skills","locale":"en"},"104":{"id":"/docs/getting-started-8","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#8-shards","content":"8. Shards","locale":"en"},"105":{"id":"/docs/getting-started-9","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#9-troubleshooting","content":"9. Troubleshooting","locale":"en"},"106":{"id":"/docs/getting-started-10","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#10-update-brok","content":"10. Update brok","locale":"en"},"107":{"id":"/docs/getting-started-11","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#11-uninstall","content":"11. Uninstall","locale":"en"},"108":{"id":"/docs/getting-started-12","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"From zero to a productive workspace in about 15 minutes. Each step is short;\nskip what you do not need.","locale":"en"},"109":{"id":"/docs/getting-started-13","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Install brok","locale":"en"},"110":{"id":"/docs/getting-started-14","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Get a local LLM (optional)","locale":"en"},"111":{"id":"/docs/getting-started-15","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Set up your first workspace","locale":"en"},"112":{"id":"/docs/getting-started-16","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Use it every day","locale":"en"},"113":{"id":"/docs/getting-started-17","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Connect your coding agent","locale":"en"},"114":{"id":"/docs/getting-started-18","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Configure","locale":"en"},"115":{"id":"/docs/getting-started-19","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Skills","locale":"en"},"116":{"id":"/docs/getting-started-20","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Shards","locale":"en"},"117":{"id":"/docs/getting-started-21","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Troubleshooting","locale":"en"},"118":{"id":"/docs/getting-started-22","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Update brok","locale":"en"},"119":{"id":"/docs/getting-started-23","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Uninstall","locale":"en"},"120":{"id":"/docs/getting-started-24","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#1-install-brok","content":"**macOS / Linux**","locale":"en"},"121":{"id":"/docs/getting-started-25","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#1-install-brok","content":"**Windows (PowerShell)**","locale":"en"},"122":{"id":"/docs/getting-started-26","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#1-install-brok","content":"Both install two programs, `brok` and `brok-agent`, and check their\nchecksums. Open a new terminal and check:","locale":"en"},"123":{"id":"/docs/getting-started-27","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#1-install-brok","content":"**Company laptop blocks the script?** Download `brok-windows-x86_64.exe`\nfrom the brok release\nand `brok-agent-windows-x86_64.exe` from the\nagent release,\nrename them `brok.exe` and `brok-agent.exe`, put both in one folder and add\nthat folder to your `PATH`.","locale":"en"},"124":{"id":"/docs/getting-started-28","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#1-install-brok","content":"**Prefer Cargo?** `cargo install brok-cli brok-agent` (needs a C compiler and\n`protoc`), or `cargo install brok-cli brok-agent --no-default-features` for a\nlighter build with text search only.","locale":"en"},"125":{"id":"/docs/getting-started-29","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#2-get-a-local-llm-optional","content":"Search works without any LLM. Answers (`brok ask`, `chat`, `review`,\n`commit`) need one. A local model is free, private and works offline.","locale":"en"},"126":{"id":"/docs/getting-started-30","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#2-get-a-local-llm-optional","content":"**Ollama** (recommended):","locale":"en"},"127":{"id":"/docs/getting-started-31","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#2-get-a-local-llm-optional","content":"| OS      | Install                        |\n| ------- | ------------------------------ |\n| Windows | `winget install Ollama.Ollama` |","locale":"en","table":"table-0"},"128":{"id":"/docs/getting-started-32","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#2-get-a-local-llm-optional","content":"| OS    | Install               |\n| ----- | --------------------- |\n| macOS | `brew install ollama` |","locale":"en","table":"table-0"},"129":{"id":"/docs/getting-started-33","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#2-get-a-local-llm-optional","content":"| OS    | Install                                          |\n| ----- | ------------------------------------------------ |\n| Linux | `curl -fsSL https://ollama.com/install.sh \\| sh` |","locale":"en","table":"table-0"},"130":{"id":"/docs/getting-started-34","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#2-get-a-local-llm-optional","content":"Pick the model for your machine:","locale":"en"},"131":{"id":"/docs/getting-started-35","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#2-get-a-local-llm-optional","content":"| Your machine | Model                | Download                         |\n| ------------ | -------------------- | -------------------------------- |\n| 8 GB         | `qwen2.5-coder:1.5b` | `ollama pull qwen2.5-coder:1.5b` |","locale":"en","table":"table-1"},"132":{"id":"/docs/getting-started-36","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#2-get-a-local-llm-optional","content":"| Your machine                          | Model              | Download                       |\n| ------------------------------------- | ------------------ | ------------------------------ |\n| 16 GB, no GPU (most business laptops) | `qwen2.5-coder:3b` | `ollama pull qwen2.5-coder:3b` |","locale":"en","table":"table-1"},"133":{"id":"/docs/getting-started-37","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#2-get-a-local-llm-optional","content":"| Your machine                                                   | Model              | Download                       |\n| -------------------------------------------------------------- | ------------------ | ------------------------------ |\n| 16 GB with a GPU (6 GB+) or Apple Silicon; 32 GB without a GPU | `qwen2.5-coder:7b` | `ollama pull qwen2.5-coder:7b` |","locale":"en","table":"table-1"},"134":{"id":"/docs/getting-started-38","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#2-get-a-local-llm-optional","content":"| Your machine                                            | Model               | Download                        |\n| ------------------------------------------------------- | ------------------- | ------------------------------- |\n| A GPU with 12 GB+, or 32 GB with a GPU or Apple Silicon | `qwen2.5-coder:14b` | `ollama pull qwen2.5-coder:14b` |","locale":"en","table":"table-1"},"135":{"id":"/docs/getting-started-39","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#2-get-a-local-llm-optional","content":"Not sure? Skip the pull: `brok init` (next step) measures your machine and\noffers to download the right one.","locale":"en"},"136":{"id":"/docs/getting-started-40","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#2-get-a-local-llm-optional","content":"Small models (1.5b, 3b) are fine for questions (`ask`, `chat`); reviews and\ncommit messages are much better with 7b or larger. Without a GPU, a 7b\nmodel takes a few minutes per review, which is why the table suggests 3b\nthere.","locale":"en"},"137":{"id":"/docs/getting-started-41","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#2-get-a-local-llm-optional","content":"Prefer a graphical app? LM Studio works too: download a\nmodel, open **Developer / Local Server** and press **Start Server**. More in\nLocal LLM setup.","locale":"en"},"138":{"id":"/docs/getting-started-42","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#3-set-up-your-first-workspace","content":"Go to your project (one repository, or a folder holding several) and run\n(want a sample project first? clone\nexample-nestjs):","locale":"en"},"139":{"id":"/docs/getting-started-43","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#3-set-up-your-first-workspace","content":"It walks through six steps and asks before anything big:","locale":"en"},"140":{"id":"/docs/getting-started-44","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#3-set-up-your-first-workspace","content":"| Step         | What happens                                      |\n| ------------ | ------------------------------------------------- |\n| 1. Workspace | Creates `.brokspace/` with a commented `brok.yml` |","locale":"en","table":"table-2"},"141":{"id":"/docs/getting-started-45","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#3-set-up-your-first-workspace","content":"| Step     | What happens                                                               |\n| -------- | -------------------------------------------------------------------------- |\n| 2. Agent | Installs `brok-agent`, the helper that tracks changes and talks to the LLM |","locale":"en","table":"table-2"},"142":{"id":"/docs/getting-started-46","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#3-set-up-your-first-workspace","content":"| Step               | What happens                                                           |\n| ------------------ | ---------------------------------------------------------------------- |\n| 3. Semantic search | Downloads the search model once (~140 MB, shared by all your projects) |","locale":"en","table":"table-2"},"143":{"id":"/docs/getting-started-47","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#3-set-up-your-first-workspace","content":"| Step         | What happens                                                      |\n| ------------ | ----------------------------------------------------------------- |\n| 4. Local LLM | Finds Ollama / LM Studio and picks a model that fits your machine |","locale":"en","table":"table-2"},"144":{"id":"/docs/getting-started-48","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#3-set-up-your-first-workspace","content":"| Step     | What happens                                                      |\n| -------- | ----------------------------------------------------------------- |\n| 5. Index | Indexes your code (functions, classes and sections, not raw text) |","locale":"en","table":"table-2"},"145":{"id":"/docs/getting-started-49","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#3-set-up-your-first-workspace","content":"| Step             | What happens                                                          |\n| ---------------- | --------------------------------------------------------------------- |\n| 6. Coding agents | Connects Claude Code, Cursor, VS Code or Codex (skills + search tool) |","locale":"en","table":"table-2"},"146":{"id":"/docs/getting-started-50","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#3-set-up-your-first-workspace","content":"Want no questions? `brok init --yes` accepts every recommendation.\nThen check the result:","locale":"en"},"147":{"id":"/docs/getting-started-51","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#3-set-up-your-first-workspace","content":"Every line is either ✓, or a `!` with the exact command that fixes it.","locale":"en"},"148":{"id":"/docs/getting-started-52","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#3-set-up-your-first-workspace","content":"> Your next project is faster: the search model and your LLM choice are\n> remembered, so `brok init` there takes seconds.","locale":"en"},"149":{"id":"/docs/getting-started-53","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#4-use-it-every-day","content":"The first `ask`, `chat`, `review` or `commit` starts brok in the background.\nFrom then on the index follows you: saved files, commits, pulls and branch\nswitches are picked up within seconds.","locale":"en"},"150":{"id":"/docs/getting-started-54","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#4-use-it-every-day","content":"| You want to...                      | Run                        |\n| ----------------------------------- | -------------------------- |\n| Start / stop the background service | `brok start` / `brok stop` |","locale":"en","table":"table-3"},"151":{"id":"/docs/getting-started-55","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#4-use-it-every-day","content":"| You want to...                      | Run            |\n| ----------------------------------- | -------------- |\n| Restart it after editing `brok.yml` | `brok restart` |","locale":"en","table":"table-3"},"152":{"id":"/docs/getting-started-56","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#4-use-it-every-day","content":"| You want to...       | Run            |\n| -------------------- | -------------- |\n| See what it is doing | `brok logs -f` |","locale":"en","table":"table-3"},"153":{"id":"/docs/getting-started-57","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#4-use-it-every-day","content":"| You want to...      | Run           |\n| ------------------- | ------------- |\n| See what is indexed | `brok status` |","locale":"en","table":"table-3"},"154":{"id":"/docs/getting-started-58","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#4-use-it-every-day","content":"| You want to...                          | Run                                                |\n| --------------------------------------- | -------------------------------------------------- |\n| Review only staged changes, or a branch | `brok review --staged` / `brok review --base main` |","locale":"en","table":"table-3"},"155":{"id":"/docs/getting-started-59","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#4-use-it-every-day","content":"| You want to...              | Run                   |\n| --------------------------- | --------------------- |\n| Just print a commit message | `brok commit --print` |","locale":"en","table":"table-3"},"156":{"id":"/docs/getting-started-60","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#4-use-it-every-day","content":"| You want to...                         | Run                           |\n| -------------------------------------- | ----------------------------- |\n| Use a different model for one question | `brok ask -p anthropic \"...\"` |","locale":"en","table":"table-3"},"157":{"id":"/docs/getting-started-61","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#4-use-it-every-day","content":"| You want to...                          | Run                                   |\n| --------------------------------------- | ------------------------------------- |\n| Show whole results, or JSON for scripts | `brok search \"...\" --full` / `--json` |","locale":"en","table":"table-3"},"158":{"id":"/docs/getting-started-62","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#4-use-it-every-day","content":"| You want to...                 | Run                    |\n| ------------------------------ | ---------------------- |\n| Rebuild the index from scratch | `brok index --rebuild` |","locale":"en","table":"table-3"},"159":{"id":"/docs/getting-started-63","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#4-use-it-every-day","content":"| You want to... | Run                                                               |\n| -------------- | ----------------------------------------------------------------- |\n| Tab completion | `brok completions bash >> ~/.bashrc` (also zsh, fish, powershell) |","locale":"en","table":"table-3"},"160":{"id":"/docs/getting-started-64","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#4-use-it-every-day","content":"**About AI reviews.** With a local 7b model, `brok review` is a quick first\npass: it catches slips you would rather not push, but it also gets things\nwrong (we have seen it invent a missing validation). Read its findings as\nquestions, not verdicts. For a review you want to rely on, use a 14b model\nor a hosted one for that run: `brok review -p anthropic` (see\nConfigure for API keys).","locale":"en"},"161":{"id":"/docs/getting-started-65","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#4-use-it-every-day","content":"Inside `brok chat`: `/skill grill-me` applies a skill to the conversation,\n`/clear` forgets it, `/exit` leaves.","locale":"en"},"162":{"id":"/docs/getting-started-66","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#5-connect-your-coding-agent","content":"If you skipped step 6 of `brok init`:","locale":"en"},"163":{"id":"/docs/getting-started-67","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#5-connect-your-coding-agent","content":"It detects your agents and, for each one, adds:","locale":"en"},"164":{"id":"/docs/getting-started-68","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#5-connect-your-coding-agent","content":"a **search tool** (`brok_search`) through MCP, so the agent finds code by\nmeaning before grepping;","locale":"en"},"165":{"id":"/docs/getting-started-69","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#5-connect-your-coding-agent","content":"the **built-in skills**, such as `/ask-brok`, `/grill-me`, `/to-spec`,\n`tdd` and `code-review`.","locale":"en"},"166":{"id":"/docs/getting-started-70","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#5-connect-your-coding-agent","content":"| Agent       | Files written                  |\n| ----------- | ------------------------------ |\n| Claude Code | `.mcp.json`, `.claude/skills/` |","locale":"en","table":"table-4"},"167":{"id":"/docs/getting-started-71","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#5-connect-your-coding-agent","content":"| Agent  | Files written                         |\n| ------ | ------------------------------------- |\n| Cursor | `.cursor/mcp.json`, `.agents/skills/` |","locale":"en","table":"table-4"},"168":{"id":"/docs/getting-started-72","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#5-connect-your-coding-agent","content":"| Agent             | Files written                         |\n| ----------------- | ------------------------------------- |\n| VS Code / Copilot | `.vscode/mcp.json`, `.agents/skills/` |","locale":"en","table":"table-4"},"169":{"id":"/docs/getting-started-73","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#5-connect-your-coding-agent","content":"| Agent | Files written                                                       |\n| ----- | ------------------------------------------------------------------- |\n| Codex | `.agents/skills/` (prints the MCP lines for `~/.codex/config.toml`) |","locale":"en","table":"table-4"},"170":{"id":"/docs/getting-started-74","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#5-connect-your-coding-agent","content":"Commit these files and your whole team gets the same setup. In your agent,\nstart with `/ask-brok` and describe what you want to do.","locale":"en"},"171":{"id":"/docs/getting-started-75","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#6-configure","content":"Everything lives in **`.brokspace/brok.yml`**. Every key is optional and the\ndefaults are sensible. The settings people change most:","locale":"en"},"172":{"id":"/docs/getting-started-76","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#6-configure","content":"Easier ways to change things:","locale":"en"},"173":{"id":"/docs/getting-started-77","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#6-configure","content":"| Change                        | Command                                                                    |\n| ----------------------------- | -------------------------------------------------------------------------- |\n| Switch the local LLM or model | `brok setup llm` (or `brok setup llm --provider ollama --model llama3:8b`) |","locale":"en","table":"table-5"},"174":{"id":"/docs/getting-started-78","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#6-configure","content":"| Change                     | Command             |\n| -------------------------- | ------------------- |\n| Connect more coding agents | `brok setup agents` |","locale":"en","table":"table-5"},"175":{"id":"/docs/getting-started-79","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#6-configure","content":"| Change                                   | Command           |\n| ---------------------------------------- | ----------------- |\n| Share the index (Git LFS, S3, R2, MinIO) | `brok setup sync` |","locale":"en","table":"table-5"},"176":{"id":"/docs/getting-started-80","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#6-configure","content":"After editing `brok.yml`, run `brok restart`. Every key is explained in\nConfiguration reference.","locale":"en"},"177":{"id":"/docs/getting-started-81","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#6-configure","content":"**API keys** are never written to files: export them in your shell\n(`export ANTHROPIC_API_KEY=...`, or `$env:ANTHROPIC_API_KEY = \"...\"` in\nPowerShell) and Brokspace reads them when needed. Secrets found in your code\nare removed from the context before anything is sent to an LLM.","locale":"en"},"178":{"id":"/docs/getting-started-82","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#7-skills","content":"A skill is a small, reusable workflow for AI: a `SKILL.md` file with\ninstructions. Brokspace ships 20 of them.","locale":"en"},"179":{"id":"/docs/getting-started-83","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#7-skills","content":"**User-invoked** skills are started by you (type `/name` in your agent, e.g.\n`/grill-me` before a big change). **Model-invoked** skills are picked by the\nagent when the task fits (e.g. `tdd`, `code-review`).","locale":"en"},"180":{"id":"/docs/getting-started-84","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#7-skills","content":"Write your own:","locale":"en"},"181":{"id":"/docs/getting-started-85","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#7-skills","content":"A workspace skill with the same name as a built-in one replaces it, so you\ncan tailor any built-in to your team. More in Skills.","locale":"en"},"182":{"id":"/docs/getting-started-86","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#8-shards","content":"Shards are small programs that react to what happens in your workspace (a\nfile changed, a question was asked) and can publish their own events. The\nagent you installed is one.","locale":"en"},"183":{"id":"/docs/getting-started-87","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#8-shards","content":"Every shard lists the permissions it wants in `shard.json`, and you approve\nthem when installing. Guide: Shards.","locale":"en"},"184":{"id":"/docs/getting-started-88","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#9-troubleshooting","content":"Start with `brok doctor`: it checks everything and prints the fix.","locale":"en"},"185":{"id":"/docs/getting-started-89","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#9-troubleshooting","content":"| Symptom                    | Fix                                                          |\n| -------------------------- | ------------------------------------------------------------ |\n| `no answer from the agent` | Start your LLM (open Ollama / LM Studio), then `brok doctor` |","locale":"en","table":"table-6"},"186":{"id":"/docs/getting-started-90","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#9-troubleshooting","content":"| Symptom                       | Fix                                             |\n| ----------------------------- | ----------------------------------------------- |\n| `ollama ... is not installed` | `ollama pull <model>` as shown by `brok doctor` |","locale":"en","table":"table-6"},"187":{"id":"/docs/getting-started-91","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#9-troubleshooting","content":"| Symptom              | Fix                                                                                                                                                                                                                                 |\n| -------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| Answers take minutes | The model runs on your CPU. Normal for 7b on a laptop without a GPU (a review can take 3 to 5 minutes); for faster answers use 3b: `ollama pull qwen2.5-coder:3b`, then `brok setup llm --provider ollama --model qwen2.5-coder:3b` |","locale":"en","table":"table-6"},"188":{"id":"/docs/getting-started-92","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#9-troubleshooting","content":"| Symptom                   | Fix                                                              |\n| ------------------------- | ---------------------------------------------------------------- |\n| Search misses recent code | `brok status`; if the daemon is stopped, `brok start` catches up |","locale":"en","table":"table-6"},"189":{"id":"/docs/getting-started-93","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#9-troubleshooting","content":"| Symptom                                     | Fix                                                                                                      |\n| ------------------------------------------- | -------------------------------------------------------------------------------------------------------- |\n| `another brok process is writing the index` | `brok` is running in the background and already indexes for you; skip `brok index`, or `brok stop` first |","locale":"en","table":"table-6"},"190":{"id":"/docs/getting-started-94","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#9-troubleshooting","content":"| Symptom                        | Fix                                                |\n| ------------------------------ | -------------------------------------------------- |\n| Results come back as text only | The search model is missing: `brok model download` |","locale":"en","table":"table-6"},"191":{"id":"/docs/getting-started-95","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#9-troubleshooting","content":"| Symptom                            | Fix                                                                     |\n| ---------------------------------- | ----------------------------------------------------------------------- |\n| Agent does not show the brok tools | `brok` must be on `PATH`; run `brok setup agents` and restart the agent |","locale":"en","table":"table-6"},"192":{"id":"/docs/getting-started-96","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#9-troubleshooting","content":"| Symptom                       | Fix                                                    |\n| ----------------------------- | ------------------------------------------------------ |\n| Odd behavior after an upgrade | `brok restart`; if it persists, `brok index --rebuild` |","locale":"en","table":"table-6"},"193":{"id":"/docs/getting-started-97","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#9-troubleshooting","content":"| Symptom                          | Fix                                                                         |\n| -------------------------------- | --------------------------------------------------------------------------- |\n| Windows: errors about long paths | Enable long paths (`brok doctor` shows the command) or use a shorter folder |","locale":"en","table":"table-6"},"194":{"id":"/docs/getting-started-98","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#9-troubleshooting","content":"Still stuck? Run `brok logs -n 100` and ask in\nDiscussions, including the\noutput of `brok doctor`.","locale":"en"},"195":{"id":"/docs/getting-started-99","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#10-update-brok","content":"`brok upgrade` downloads the new `brok` and `brok-agent`, checks them\nagainst the release checksums, swaps them in and restarts brok in every\nworkspace where it was running (each workspace's agent is refreshed on\nthat restart). `brok doctor` tells you when a new version is out.","locale":"en"},"196":{"id":"/docs/getting-started-100","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#10-update-brok","content":"Then run `brok skill export` in your workspaces so your coding agents get\nthe updated built-in skills.","locale":"en"},"197":{"id":"/docs/getting-started-101","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#10-update-brok","content":"Installed with Cargo? Upgrade with `cargo install brok-cli brok-agent`.\nComing from brok 0.2.1 or older (no `upgrade` command yet)? Run the install\ncommand from step 1 again, once.","locale":"en"},"198":{"id":"/docs/getting-started-102","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#11-uninstall","content":"Then delete:","locale":"en"},"199":{"id":"/docs/getting-started-103","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#11-uninstall","content":"the `.brokspace/` folder of each workspace (plus `.agents/skills`,\n`.claude/skills` and the MCP files if you no longer want them);","locale":"en"},"200":{"id":"/docs/getting-started-104","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#11-uninstall","content":"the shared model cache: `~/.cache/brokspace` (Linux),\n`~/Library/Caches/brokspace` (macOS), `%LOCALAPPDATA%\\brokspace` (Windows);","locale":"en"},"201":{"id":"/docs/getting-started-105","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#11-uninstall","content":"your defaults: `~/.config/brokspace` (Linux),\n`~/Library/Application Support/brokspace` (macOS), `%APPDATA%\\brokspace`\n(Windows);","locale":"en"},"202":{"id":"/docs/getting-started-106","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#11-uninstall","content":"the `brok` and `brok-agent` programs (`~/.local/bin`, or\n`%LOCALAPPDATA%\\Programs\\brok` on Windows; `cargo uninstall brok-cli brok-agent`\nif you used Cargo).","locale":"en"},"203":{"id":"/docs/hub","page_id":"/docs/hub","type":"page","content":"Shard Hub (preview)","breadcrumbs":["Brokspace","Ecosystem"],"tags":[],"url":"/docs/hub","locale":"en"},"204":{"id":"/docs/hub-0","page_id":"/docs/hub","tags":[],"type":"text","url":"/docs/hub","content":"The official home of shards, skills and agents for Brokspace.","locale":"en"},"205":{"id":"/docs/hub-1","page_id":"/docs/hub","tags":[],"type":"text","url":"/docs/hub","content":"The Hub is being built. Until it opens, install shards from any git\nrepository with `brok shard install <url>`.","locale":"en"},"206":{"id":"/docs/hub-2","page_id":"/docs/hub","tags":[],"type":"text","url":"/docs/hub","content":"The Brokspace Hub will be the official catalog of shards built by the\nBrokspace team, and later a registry anyone can publish to, in the spirit of\nDocker Hub:","locale":"en"},"207":{"id":"/docs/hub-3","page_id":"/docs/hub","tags":[],"type":"text","url":"/docs/hub","content":"**Official shards and skill packs**, reviewed and versioned.","locale":"en"},"208":{"id":"/docs/hub-4","page_id":"/docs/hub","tags":[],"type":"text","url":"/docs/hub","content":"**One-command install** from the CLI and from the Brokspace IDE.","locale":"en"},"209":{"id":"/docs/hub-5","page_id":"/docs/hub","tags":[],"type":"text","url":"/docs/hub","content":"**Permissions up front:** every shard lists what it may read, write, run\nand reach, before you install it.","locale":"en"},"210":{"id":"/docs/hub-6","page_id":"/docs/hub","tags":[],"type":"text","url":"/docs/hub","content":"Today, build your own with Shards and\nSkills, and start from the\nshard template.","locale":"en"},"211":{"id":"/docs/ide","page_id":"/docs/ide","type":"page","content":"Brokspace IDE","breadcrumbs":["Brokspace","Brokspace IDE"],"tags":[],"url":"/docs/ide","locale":"en"},"212":{"id":"/docs/ide-0","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide","content":"An IDE with Brokspace built in, for IDE mode next to the brok CLI.","locale":"en"},"213":{"id":"/docs/ide-1","page_id":"/docs/ide","type":"heading","tags":[],"url":"/docs/ide#install","content":"Install","locale":"en"},"214":{"id":"/docs/ide-2","page_id":"/docs/ide","type":"heading","tags":[],"url":"/docs/ide#your-first-minutes","content":"Your first minutes","locale":"en"},"215":{"id":"/docs/ide-3","page_id":"/docs/ide","type":"heading","tags":[],"url":"/docs/ide#the-brokspace-view","content":"The Brokspace view","locale":"en"},"216":{"id":"/docs/ide-4","page_id":"/docs/ide","type":"heading","tags":[],"url":"/docs/ide#the-brokspace-agent","content":"The Brokspace agent","locale":"en"},"217":{"id":"/docs/ide-5","page_id":"/docs/ide","type":"heading","tags":[],"url":"/docs/ide#commands-and-languages","content":"Commands and languages","locale":"en"},"218":{"id":"/docs/ide-6","page_id":"/docs/ide","type":"heading","tags":[],"url":"/docs/ide#how-it-works","content":"How it works","locale":"en"},"219":{"id":"/docs/ide-7","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide","content":"Brokspace IDE is built on Eclipse Theia, so VS\nCode extensions from Open VSX work in it. It ships\nwith `brok` and `brok-agent`, and puts them on your `PATH`.","locale":"en"},"220":{"id":"/docs/ide-8","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#install","content":"The first launch needs right click > **Open** while the app is not\nnotarized yet.","locale":"en"},"221":{"id":"/docs/ide-9","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#install","content":"Download the AppImage or the `.tar.gz` from the\nlatest release.","locale":"en"},"222":{"id":"/docs/ide-10","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#install","content":"Download `BrokspaceIDE-<version>-windows-x64-setup.exe` from the\nlatest release. Choose\n**More info > Run anyway** in SmartScreen while the installer is not\nsigned yet.","locale":"en"},"223":{"id":"/docs/ide-11","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#install","content":"The IDE updates itself from GitHub Releases. For answers you need an LLM:\nsee Local LLM setup (search works without one).","locale":"en"},"224":{"id":"/docs/ide-12","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#your-first-minutes","content":"The window starts minimal: Explorer, Search, Source Control and Brokspace on\nthe left, the **Brokspace agent** docked on the right. Debug, Testing and\nExtensions stay one shortcut away.","locale":"en"},"225":{"id":"/docs/ide-13","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#your-first-minutes","content":"**Open a folder** (File > Open Folder). If it has no Brokspace workspace\nyet, the Brokspace view offers **Set Up Workspace**: it runs `brok init`\nfor you.","locale":"en"},"226":{"id":"/docs/ide-14","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#your-first-minutes","content":"**Ask.** Type a question on the home page or in the agent panel: the\nBrokspace agent answers from your LLM with the sources it used; click a\nsource to open the file at that line. Follow-up questions keep the\nconversation. Press `Ctrl+Shift+A` (`Cmd+Shift+A` on macOS) for **agent\nfocus mode**, where the agent takes most of the window.","locale":"en"},"227":{"id":"/docs/ide-15","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#your-first-minutes","content":"**Search.** The Brokspace view (the folded \"B\" in the activity bar) finds\ncode by meaning or by name; click a result to open it.","locale":"en"},"228":{"id":"/docs/ide-16","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#your-first-minutes","content":"**Review and commit.** Type `/review` in the chat (or `/review staged`,\n`/review base main`). In Source Control, the ✨ button writes the commit\nmessage from the staged changes.","locale":"en"},"229":{"id":"/docs/ide-17","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#the-brokspace-view","content":"| Section      | What it shows                                                                         |\n| ------------ | ------------------------------------------------------------------------------------- |\n| **Overview** | Whether Brokspace is running, the model, the index, search, and Ask / Review / Commit |","locale":"en","table":"table-0"},"230":{"id":"/docs/ide-18","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#the-brokspace-view","content":"| Section    | What it shows                                                                                                                                                                                                                                        |\n| ---------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| **Shards** | Each installed shard and its state; expand one to see what it reads and writes, whether it uses the network, the programs it runs, the events it listens to and publishes, and where it came from. Install, create or remove shards from the toolbar |","locale":"en","table":"table-0"},"231":{"id":"/docs/ide-19","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#the-brokspace-view","content":"| Section    | What it shows                                                      |\n| ---------- | ------------------------------------------------------------------ |\n| **Skills** | Workflows you run and the skills your agents use; click to run one |","locale":"en","table":"table-0"},"232":{"id":"/docs/ide-20","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#the-brokspace-agent","content":"Every request goes through `brok`, which sends it to the LLM set in\n`.brokspace/brok.yml` (Ollama, LM Studio or a hosted OpenAI-compatible API).\nWithout an LLM, or when it does not answer, the agent replies with what the\nlocal index found, as links.","locale":"en"},"233":{"id":"/docs/ide-21","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#the-brokspace-agent","content":"| Type       | It runs                                 |\n| ---------- | --------------------------------------- |\n| A question | `brok ask` with the conversation so far |","locale":"en","table":"table-1"},"234":{"id":"/docs/ide-22","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#the-brokspace-agent","content":"| Type      | It runs                              |\n| --------- | ------------------------------------ |\n| `/review` | A review of your uncommitted changes |","locale":"en","table":"table-1"},"235":{"id":"/docs/ide-23","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#the-brokspace-agent","content":"| Type             | It runs                        |\n| ---------------- | ------------------------------ |\n| `/review staged` | A review of the staged changes |","locale":"en","table":"table-1"},"236":{"id":"/docs/ide-24","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#the-brokspace-agent","content":"| Type                 | It runs                                 |\n| -------------------- | --------------------------------------- |\n| `/review base <ref>` | A review of this branch against `<ref>` |","locale":"en","table":"table-1"},"237":{"id":"/docs/ide-25","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#the-brokspace-agent","content":"| Type                    | It runs                                                     |\n| ----------------------- | ----------------------------------------------------------- |\n| `/skill <name> <input>` | A skill on your LLM, e.g. `/skill tdd add a priority field` |","locale":"en","table":"table-1"},"238":{"id":"/docs/ide-26","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#commands-and-languages","content":"Everything is also in the **Brokspace** menu and the command palette:\nSet Up Workspace, Start / Stop / Restart, Rebuild Index, Doctor, Install,\nCreate and Remove Shard, Export Skills to Coding Agents, Run Skill, Review,\nWrite Commit Message. The status bar shows whether Brokspace is running and\nwhich model it uses.","locale":"en"},"239":{"id":"/docs/ide-27","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#commands-and-languages","content":"The IDE is in English and Brazilian Portuguese. It starts in Portuguese on a\nPortuguese system; switch with **Language** on the home page.","locale":"en"},"240":{"id":"/docs/ide-28","page_id":"/docs/ide","tags":[],"type":"text","url":"/docs/ide#how-it-works","content":"The IDE talks to Brokspace only through the `brok` CLI and its JSON output\n(see Integrations), so it shows exactly what `brok`\nsees, and anything it does you can also do in a terminal. It needs brok\n0.2.4 or newer; the one it ships with qualifies.","locale":"en"},"241":{"id":"/docs","page_id":"/docs","type":"page","content":"Introduction","breadcrumbs":["Brokspace","Start"],"tags":[],"url":"/docs","locale":"en"},"242":{"id":"/docs-0","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Brokspace makes any development workspace searchable and agent-ready, on your machine.","locale":"en"},"243":{"id":"/docs-1","page_id":"/docs","type":"heading","tags":[],"url":"/docs#two-ways-to-use-it","content":"Two ways to use it","locale":"en"},"244":{"id":"/docs-2","page_id":"/docs","type":"heading","tags":[],"url":"/docs#what-you-get","content":"What you get","locale":"en"},"245":{"id":"/docs-3","page_id":"/docs","type":"heading","tags":[],"url":"/docs#start","content":"Start","locale":"en"},"246":{"id":"/docs-4","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Brokspace (`brok`) indexes your code (one repository, its submodules, or a\nwhole folder of repositories) into a local hybrid search engine, connects it\nto the LLM you choose, and plugs it into the coding agents you already use.\nNothing leaves your machine unless you choose a hosted model.","locale":"en"},"247":{"id":"/docs-5","page_id":"/docs","tags":[],"type":"text","url":"/docs#two-ways-to-use-it","content":"In any terminal and any editor. `brok search`, `ask`, `chat`, `review`,\n`commit`, skills and shards. Your coding agents get the `brok_search`\ntool through MCP.","locale":"en"},"248":{"id":"/docs-6","page_id":"/docs","tags":[],"type":"text","url":"/docs#two-ways-to-use-it","content":"The same workspace in an IDE built around it: a home page that starts\nwith your question, the Brokspace agent in the chat, search, reviews and\ncommit messages one click away.","locale":"en"},"249":{"id":"/docs-7","page_id":"/docs","tags":[],"type":"text","url":"/docs#two-ways-to-use-it","content":"Both share the same `.brokspace/` folder, so you can switch at any time.","locale":"en"},"250":{"id":"/docs-8","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-you-get","content":"**Search that understands code.** Functions, classes and sections are\nindexed whole, found by meaning or by name, across every repository.","locale":"en"},"251":{"id":"/docs-9","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-you-get","content":"**Answers with sources.** Ask your own LLM (Ollama, LM Studio, or a hosted\nmodel) about the workspace; every answer lists the code it used.","locale":"en"},"252":{"id":"/docs-10","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-you-get","content":"**Reviews and commit messages** from your staged or uncommitted changes.","locale":"en"},"253":{"id":"/docs-11","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-you-get","content":"**Skills:** 20 built-in workflows for AI (TDD, code review, specs...), and\nyour own in a `SKILL.md`.","locale":"en"},"254":{"id":"/docs-12","page_id":"/docs","tags":[],"type":"text","url":"/docs#what-you-get","content":"**Shards:** small programs that react to your workspace through a local,\npermissioned event bus.","locale":"en"},"255":{"id":"/docs-13","page_id":"/docs","tags":[],"type":"text","url":"/docs#start","content":"Install, set up your first workspace, use it every day: about 15 minutes.","locale":"en"},"256":{"id":"/docs-14","page_id":"/docs","tags":[],"type":"text","url":"/docs#start","content":"Pick a model that fits your machine and run it with Ollama or LM Studio.","locale":"en"},"257":{"id":"/docs-15","page_id":"/docs","tags":[],"type":"text","url":"/docs#start","content":"The built-in workflows, and how to write and share your own.","locale":"en"},"258":{"id":"/docs-16","page_id":"/docs","tags":[],"type":"text","url":"/docs#start","content":"Build integrations that react to your workspace.","locale":"en"},"259":{"id":"/docs-17","page_id":"/docs","tags":[],"type":"text","url":"/docs#start","content":"Brokspace is open source (MIT or Apache-2.0). Questions and ideas go to\nGitHub Discussions.","locale":"en"},"260":{"id":"/docs/integrations","page_id":"/docs/integrations","type":"page","content":"Integrations","breadcrumbs":["Brokspace","Guides"],"tags":[],"url":"/docs/integrations","locale":"en"},"261":{"id":"/docs/integrations-0","page_id":"/docs/integrations","type":"heading","tags":[],"url":"/docs/integrations#coding-agents","content":"Coding agents","locale":"en"},"262":{"id":"/docs/integrations-1","page_id":"/docs/integrations","type":"heading","tags":[],"url":"/docs/integrations#local-and-hosted-llms","content":"Local and hosted LLMs","locale":"en"},"263":{"id":"/docs/integrations-2","page_id":"/docs/integrations","type":"heading","tags":[],"url":"/docs/integrations#editors-and-scripts-json-output","content":"Editors and scripts: JSON output","locale":"en"},"264":{"id":"/docs/integrations-3","page_id":"/docs/integrations","type":"heading","tags":[],"url":"/docs/integrations#shards-integrations-you-build","content":"Shards: integrations you build","locale":"en"},"265":{"id":"/docs/integrations-4","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations","content":"Brokspace stays small and plugs into the tools you already use.","locale":"en"},"266":{"id":"/docs/integrations-5","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations","content":"| Integration                                                   | How                | Setup               |\n| ------------------------------------------------------------- | ------------------ | ------------------- |\n| Coding agents (Claude Code, Cursor, VS Code / Copilot, Codex) | MCP tools + skills | `brok setup agents` |","locale":"en","table":"table-0"},"267":{"id":"/docs/integrations-6","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations","content":"| Integration                    | How                   | Setup            |\n| ------------------------------ | --------------------- | ---------------- |\n| Local LLMs (Ollama, LM Studio) | OpenAI-compatible API | `brok setup llm` |","locale":"en","table":"table-0"},"268":{"id":"/docs/integrations-7","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations","content":"| Integration                                              | How                           | Setup              |\n| -------------------------------------------------------- | ----------------------------- | ------------------ |\n| Hosted LLMs (Anthropic, DeepSeek, any OpenAI-compatible) | `llm.providers` in `brok.yml` | export the API key |","locale":"en","table":"table-0"},"269":{"id":"/docs/integrations-8","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations","content":"| Integration        | How                                  | Setup     |\n| ------------------ | ------------------------------------ | --------- |\n| Git and submodules | change tracking, hot/cold partitions | automatic |","locale":"en","table":"table-0"},"270":{"id":"/docs/integrations-9","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations","content":"| Integration                           | How             | Setup             |\n| ------------------------------------- | --------------- | ----------------- |\n| Team storage (S3, R2, MinIO, Git LFS) | index mirroring | `brok setup sync` |","locale":"en","table":"table-0"},"271":{"id":"/docs/integrations-10","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations","content":"| Integration   | How           | Setup            |\n| ------------- | ------------- | ---------------- |\n| Anything else | write a shard | `brok shard new` |","locale":"en","table":"table-0"},"272":{"id":"/docs/integrations-11","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#coding-agents","content":"For each agent it does two things.","locale":"en"},"273":{"id":"/docs/integrations-12","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#coding-agents","content":"**1. MCP server.** Registers `brok mcp` (a stdio\nModel Context Protocol server) so the\nagent gets two tools:","locale":"en"},"274":{"id":"/docs/integrations-13","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#coding-agents","content":"| Tool          | What it does                                                                              |\n| ------------- | ----------------------------------------------------------------------------------------- |\n| `brok_search` | Hybrid search over the local index; returns whole functions/classes with `path:start-end` |","locale":"en","table":"table-1"},"275":{"id":"/docs/integrations-14","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#coding-agents","content":"| Tool          | What it does                                     |\n| ------------- | ------------------------------------------------ |\n| `brok_status` | What is indexed and whether `brok run` is active |","locale":"en","table":"table-1"},"276":{"id":"/docs/integrations-15","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#coding-agents","content":"| Agent       | File written                         |\n| ----------- | ------------------------------------ |\n| Claude Code | `.mcp.json` (`mcpServers.brokspace`) |","locale":"en","table":"table-2"},"277":{"id":"/docs/integrations-16","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#coding-agents","content":"| Agent  | File written                                |\n| ------ | ------------------------------------------- |\n| Cursor | `.cursor/mcp.json` (`mcpServers.brokspace`) |","locale":"en","table":"table-2"},"278":{"id":"/docs/integrations-17","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#coding-agents","content":"| Agent             | File written                             |\n| ----------------- | ---------------------------------------- |\n| VS Code / Copilot | `.vscode/mcp.json` (`servers.brokspace`) |","locale":"en","table":"table-2"},"279":{"id":"/docs/integrations-18","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#coding-agents","content":"| Agent | File written                                  |\n| ----- | --------------------------------------------- |\n| Codex | prints the snippet for `~/.codex/config.toml` |","locale":"en","table":"table-2"},"280":{"id":"/docs/integrations-19","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#coding-agents","content":"Existing entries in those files are preserved; only `brokspace` is added or\nupdated. When `brok run` is active, searches reuse its loaded model;\notherwise `brok mcp` opens the index read-only on demand.","locale":"en"},"281":{"id":"/docs/integrations-20","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#coding-agents","content":"**2. Skills.** Exports the skills to `.claude/skills/` (Claude\nCode) and `.agents/skills/` (Codex, Cursor, Copilot and others), so `/ask-brok`,\n`/grill-me`, `tdd`, `code-review` and the rest are available in the agent.","locale":"en"},"282":{"id":"/docs/integrations-21","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#coding-agents","content":"Commit the generated files to give your whole team the same setup. `brok`\nmust be on `PATH` for agents to start `brok mcp`; `brok doctor` checks it.","locale":"en"},"283":{"id":"/docs/integrations-22","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#local-and-hosted-llms","content":"See Local LLM setup. Any OpenAI-compatible endpoint works:","locale":"en"},"284":{"id":"/docs/integrations-23","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#editors-and-scripts-json-output","content":"Editors (the Brokspace IDE among them), scripts and CI read brok through\n`--json`. Shapes are stable within a minor version.","locale":"en"},"285":{"id":"/docs/integrations-24","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#editors-and-scripts-json-output","content":"| Command              | Output                                                                                                                                                                                                                                                                                                                                      |\n| -------------------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `brok status --json` | One document: `version`, `initialized`, `root`, `daemon.running`, `backends`, `embeddings`, `llm` (`provider`, `model`, `base_url`), `index[]` (`tier`, `path`, `files`, `chunks`, `backend`, `semantic`), `shards[]` (`name`, `version`, `description`, `state`, `source`). Outside a workspace: `{\"version\": ..., \"initialized\": false}`. |","locale":"en","table":"table-3"},"286":{"id":"/docs/integrations-25","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#editors-and-scripts-json-output","content":"| Command                      | Output                                                                                              |\n| ---------------------------- | --------------------------------------------------------------------------------------------------- |\n| `brok search <query> --json` | One document: `hits[]` with `path`, `start_line`, `end_line`, `kind`, `symbol`, `score`, `content`. |","locale":"en","table":"table-3"},"287":{"id":"/docs/integrations-26","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#editors-and-scripts-json-output","content":"| Command                  | Output                                                                          |\n| ------------------------ | ------------------------------------------------------------------------------- |\n| `brok skill list --json` | One array: `name`, `description`, `user_invoked`, `source`, `bucket` per skill. |","locale":"en","table":"table-3"},"288":{"id":"/docs/integrations-27","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#editors-and-scripts-json-output","content":"| Command                                                                  | Output                                         |\n| ------------------------------------------------------------------------ | ---------------------------------------------- |\n| `brok ask ... --json`, `brok review --json`, `brok skill run ... --json` | A stream, one JSON event per line (see below). |","locale":"en","table":"table-3"},"289":{"id":"/docs/integrations-28","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#editors-and-scripts-json-output","content":"Streaming events:","locale":"en"},"290":{"id":"/docs/integrations-29","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#editors-and-scripts-json-output","content":"A failure ends the stream with a non-zero exit code and the message on\nstderr. Follow-up questions pass the conversation so far:\n`brok ask --json --history turns.json \"and where is it tested?\"`, where\n`turns.json` holds `[{\"role\": \"user\", \"content\": \"...\"}, {\"role\":\n\"assistant\", \"content\": \"...\"}]`.","locale":"en"},"291":{"id":"/docs/integrations-30","page_id":"/docs/integrations","tags":[],"type":"text","url":"/docs/integrations#shards-integrations-you-build","content":"When something is specific to your team (a ticketing system, a deploy\npipeline, a compliance check), write a shard instead of waiting for a core\nfeature: it reacts to workspace events and publishes its own. See\nShards and start with `brok shard new my-integration`.","locale":"en"},"292":{"id":"/docs/local-llm","page_id":"/docs/local-llm","type":"page","content":"Local LLM setup","breadcrumbs":["Brokspace","Guides"],"tags":[],"url":"/docs/local-llm","locale":"en"},"293":{"id":"/docs/local-llm-0","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm","content":"Brokspace answers questions (brok ask) and runs skills (brok skill run) with any OpenAI-compatible model.","locale":"en"},"294":{"id":"/docs/local-llm-1","page_id":"/docs/local-llm","type":"heading","tags":[],"url":"/docs/local-llm#the-short-version","content":"The short version","locale":"en"},"295":{"id":"/docs/local-llm-2","page_id":"/docs/local-llm","type":"heading","tags":[],"url":"/docs/local-llm#what-your-machine-can-run","content":"What your machine can run","locale":"en"},"296":{"id":"/docs/local-llm-3","page_id":"/docs/local-llm","type":"heading","tags":[],"url":"/docs/local-llm#option-1-ollama-recommended-terminal-friendly","content":"Option 1: Ollama (recommended, terminal friendly)","locale":"en"},"297":{"id":"/docs/local-llm-4","page_id":"/docs/local-llm","type":"heading","tags":[],"url":"/docs/local-llm#option-2-lm-studio-graphical","content":"Option 2: LM Studio (graphical)","locale":"en"},"298":{"id":"/docs/local-llm-5","page_id":"/docs/local-llm","type":"heading","tags":[],"url":"/docs/local-llm#hosted-models","content":"Hosted models","locale":"en"},"299":{"id":"/docs/local-llm-6","page_id":"/docs/local-llm","type":"heading","tags":[],"url":"/docs/local-llm#using-the-same-model-elsewhere","content":"Using the same model elsewhere","locale":"en"},"300":{"id":"/docs/local-llm-7","page_id":"/docs/local-llm","type":"heading","tags":[],"url":"/docs/local-llm#performance-tips","content":"Performance tips","locale":"en"},"301":{"id":"/docs/local-llm-8","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm","content":"Brokspace answers questions (`brok ask`) and runs skills (`brok skill run`)\nwith any OpenAI-compatible model. Running it locally keeps everything\n**free, private and offline**. Search and indexing never need an LLM.","locale":"en"},"302":{"id":"/docs/local-llm-9","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#the-short-version","content":"It:","locale":"en"},"303":{"id":"/docs/local-llm-10","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#the-short-version","content":"reads your RAM (and NVIDIA GPU memory) and picks a model size from the\ntable below;","locale":"en"},"304":{"id":"/docs/local-llm-11","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#the-short-version","content":"looks for a running **Ollama** (`localhost:11434`) or **LM Studio**\n(`localhost:1234`) server;","locale":"en"},"305":{"id":"/docs/local-llm-12","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#the-short-version","content":"uses a model you already have, or offers to download the recommended one\n(`ollama pull`);","locale":"en"},"306":{"id":"/docs/local-llm-13","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#the-short-version","content":"writes the choice to `.brokspace/brok.yml` (`llm.default`).","locale":"en"},"307":{"id":"/docs/local-llm-14","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#the-short-version","content":"Nothing installed yet? It prints the one-line install for your OS. Run it,\nthen `brok setup llm` again. `brok doctor` tells you at any time whether the\nmodel is reachable.","locale":"en"},"308":{"id":"/docs/local-llm-15","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#what-your-machine-can-run","content":"Sizes are for 4-bit quantized models (`Q4_K_M`), the best balance between\nspeed and quality.","locale":"en"},"309":{"id":"/docs/local-llm-16","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#what-your-machine-can-run","content":"| Model size | Memory and GPU | Typical hardware                 | Recommended (Ollama)                |\n| ---------- | -------------- | -------------------------------- | ----------------------------------- |\n| 1B to 3B   | 8 GB           | Office laptops, entry-level Macs | `qwen2.5-coder:1.5b`, `llama3.2:3b` |","locale":"en","table":"table-0"},"310":{"id":"/docs/local-llm-17","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#what-your-machine-can-run","content":"| Model size | Memory and GPU | Typical hardware                          | Recommended (Ollama)              |\n| ---------- | -------------- | ----------------------------------------- | --------------------------------- |\n| 3B         | 16 GB, no GPU  | Business laptops with integrated graphics | `qwen2.5-coder:3b`, `llama3.2:3b` |","locale":"en","table":"table-0"},"311":{"id":"/docs/local-llm-18","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#what-your-machine-can-run","content":"| Model size                | Memory and GPU                                                 | Typical hardware                        | Recommended (Ollama)                              |\n| ------------------------- | -------------------------------------------------------------- | --------------------------------------- | ------------------------------------------------- |\n| **7B to 9B** (sweet spot) | 16 GB with a GPU (6 GB+) or Apple Silicon; 32 GB without a GPU | Gaming laptops, M1/M2/M3 Macs, desktops | `qwen2.5-coder:7b`, `llama3:8b`, `deepseek-r1:8b` |","locale":"en","table":"table-0"},"312":{"id":"/docs/local-llm-19","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#what-your-machine-can-run","content":"| Model size | Memory and GPU                                          | Typical hardware                      | Recommended (Ollama)                   |\n| ---------- | ------------------------------------------------------- | ------------------------------------- | -------------------------------------- |\n| 14B to 32B | A GPU with 12 GB+, or 32 GB with a GPU or Apple Silicon | Workstations, Mac Pro/Max with 32 GB+ | `qwen2.5-coder:14b`, `deepseek-r1:32b` |","locale":"en","table":"table-0"},"313":{"id":"/docs/local-llm-20","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#what-your-machine-can-run","content":"Without a GPU the model runs on the processor: memory decides what fits,\nbut speed decides what is pleasant. A laptop CPU reads a long prompt into a\n7B model at about 15 tokens per second, so a review takes 3 to 5 minutes;\na 3B model is about twice as fast. That is why machines without a GPU get\none size smaller. Only NVIDIA GPUs and Apple Silicon are detected; with\nanother GPU that Ollama supports, pick the row for your GPU memory.","locale":"en"},"314":{"id":"/docs/local-llm-21","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#what-your-machine-can-run","content":"What to expect: 1B to 3B models answer questions about your code well\nenough (`brok ask`, `brok chat`), but they lose track of longer skills, so\n`brok review`, `brok commit` and most `brok skill run` workflows are much\nbetter with 7B or larger. Even at 7B, a review is a first pass that can be\nwrong; 14B and hosted models (`brok review -p anthropic`) review much\nbetter, and commit messages are already good at 7B.","locale":"en"},"315":{"id":"/docs/local-llm-22","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#what-your-machine-can-run","content":"`brok setup llm` applies exactly this table. Override it any time:","locale":"en"},"316":{"id":"/docs/local-llm-23","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#option-1-ollama-recommended-terminal-friendly","content":"| OS      | Install                                                         |\n| ------- | --------------------------------------------------------------- |\n| Windows | `winget install Ollama.Ollama` or the installer from ollama.com |","locale":"en","table":"table-1"},"317":{"id":"/docs/local-llm-24","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#option-1-ollama-recommended-terminal-friendly","content":"| OS    | Install                                          |\n| ----- | ------------------------------------------------ |\n| macOS | `brew install ollama` or the app from ollama.com |","locale":"en","table":"table-1"},"318":{"id":"/docs/local-llm-25","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#option-1-ollama-recommended-terminal-friendly","content":"| OS    | Install                                          |\n| ----- | ------------------------------------------------ |\n| Linux | `curl -fsSL https://ollama.com/install.sh \\| sh` |","locale":"en","table":"table-1"},"319":{"id":"/docs/local-llm-26","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#option-2-lm-studio-graphical","content":"Download it from lmstudio.ai (Windows `.exe`,\nmacOS `.dmg` for Apple Silicon or Intel, Linux `.AppImage`:\n`chmod +x LM_Studio-*.AppImage && ./LM_Studio-*.AppImage`).","locale":"en"},"320":{"id":"/docs/local-llm-27","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#option-2-lm-studio-graphical","content":"Search for `Qwen2.5-Coder-7B` (or the size from the table), pick a\n`Q4_K_M` or `Q5_K_M` file and download it.","locale":"en"},"321":{"id":"/docs/local-llm-28","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#option-2-lm-studio-graphical","content":"Open the **Developer / Local Server** tab, load the model and press\n**Start Server** (it listens on `http://localhost:1234`).","locale":"en"},"322":{"id":"/docs/local-llm-29","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#option-2-lm-studio-graphical","content":"Run `brok setup llm`: it finds the server and lets you pick the model.","locale":"en"},"323":{"id":"/docs/local-llm-30","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#hosted-models","content":"Prefer a hosted model for some questions? Export its key and choose it per\nrequest; the providers are preconfigured in `brok.yml`:","locale":"en"},"324":{"id":"/docs/local-llm-31","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#hosted-models","content":"Keys are read from the environment, never stored in `brok.yml`, and secrets\nfound in retrieved code are redacted before any prompt leaves your machine.","locale":"en"},"325":{"id":"/docs/local-llm-32","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#using-the-same-model-elsewhere","content":"**Aider**: `aider --model ollama/qwen2.5-coder:7b` inside your git\nrepository (`pip install aider-chat`, Python 3.10 to 3.12).","locale":"en"},"326":{"id":"/docs/local-llm-33","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#using-the-same-model-elsewhere","content":"**Coding agents** (Claude Code, Cursor, VS Code, Codex): `brok setup agents`\ngives them the Brokspace search tool and skills; see\nIntegrations.","locale":"en"},"327":{"id":"/docs/local-llm-34","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#performance-tips","content":"**Apple Silicon**: memory is unified, so a 16 GB Mac runs 7B/8B models fast.","locale":"en"},"328":{"id":"/docs/local-llm-35","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#performance-tips","content":"**NVIDIA / AMD GPUs**: enable full GPU offload in LM Studio or Ollama.","locale":"en"},"329":{"id":"/docs/local-llm-36","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#performance-tips","content":"**Storage**: keep models on an SSD; loading from a spinning disk is painfully slow.","locale":"en"},"330":{"id":"/docs/local-llm-37","page_id":"/docs/local-llm","tags":[],"type":"text","url":"/docs/local-llm#performance-tips","content":"**Smaller is often better** for interactive use: a fast 7B beats a slow\n14B for everyday questions; switch per request with `-p`.","locale":"en"},"331":{"id":"/docs/shards","page_id":"/docs/shards","type":"page","content":"Shards","breadcrumbs":["Brokspace","Guides"],"tags":[],"url":"/docs/shards","locale":"en"},"332":{"id":"/docs/shards-0","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards","content":"Shards are small programs that react to workspace events.","locale":"en"},"333":{"id":"/docs/shards-1","page_id":"/docs/shards","type":"heading","tags":[],"url":"/docs/shards#lifecycle","content":"Lifecycle","locale":"en"},"334":{"id":"/docs/shards-2","page_id":"/docs/shards","type":"heading","tags":[],"url":"/docs/shards#shardjson","content":"`shard.json`","locale":"en"},"335":{"id":"/docs/shards-3","page_id":"/docs/shards","type":"heading","tags":[],"url":"/docs/shards#topics","content":"Topics","locale":"en"},"336":{"id":"/docs/shards-4","page_id":"/docs/shards","type":"heading","tags":[],"url":"/docs/shards#runtime-contract","content":"Runtime contract","locale":"en"},"337":{"id":"/docs/shards-5","page_id":"/docs/shards","type":"heading","tags":[],"url":"/docs/shards#using-the-sdk","content":"Using the SDK","locale":"en"},"338":{"id":"/docs/shards-6","page_id":"/docs/shards","type":"heading","tags":[],"url":"/docs/shards#security","content":"Security","locale":"en"},"339":{"id":"/docs/shards-7","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards","content":"Shards are small programs that react to workspace events. Each one is a\nseparate process connected to the `brok run` event bus, restricted to the\ntopics its manifest declares.","locale":"en"},"340":{"id":"/docs/shards-8","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards","content":"The fastest way to write one is the\nbrok-shard-template\nrepository; this page is the reference.","locale":"en"},"341":{"id":"/docs/shards-9","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#lifecycle","content":"To trigger your shard by hand, publish the event it listens to:\n`brok bus emit file:changed '{\"changed\":[\"src/main.rs\"],\"deleted\":[]}'`.\nWindows PowerShell 5.1 drops the inner double quotes when it calls a\nprogram, so escape them there: `'{\\\"changed\\\":[\\\"src/main.rs\\\"],\\\"deleted\\\":[]}'`\n(PowerShell 7 and other shells need no escaping).","locale":"en"},"342":{"id":"/docs/shards-10","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#lifecycle","content":"Installing:","locale":"en"},"343":{"id":"/docs/shards-11","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#lifecycle","content":"clones the repository (`--depth 1`, optional `--tag`) or uses the local directory;","locale":"en"},"344":{"id":"/docs/shards-12","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#lifecycle","content":"validates `shard.json` and the `brok` version requirement;","locale":"en"},"345":{"id":"/docs/shards-13","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#lifecycle","content":"**shows the requested capabilities and asks for consent** (`--yes` to skip in scripts);","locale":"en"},"346":{"id":"/docs/shards-14","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#lifecycle","content":"obtains the executable, in order of preference:","locale":"en"},"347":{"id":"/docs/shards-15","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#lifecycle","content":"a release asset for this platform, verified against its SHA-256;","locale":"en"},"348":{"id":"/docs/shards-16","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#lifecycle","content":"the manifest's `build.command`, run in the repository;","locale":"en"},"349":{"id":"/docs/shards-17","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#lifecycle","content":"an `entrypoint` already present in the repository;","locale":"en"},"350":{"id":"/docs/shards-18","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#lifecycle","content":"moves it into `.brokspace/shards/<name>/` and records the source, commit and\nbinary hash in `shards.lock`.","locale":"en"},"351":{"id":"/docs/shards-19","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#lifecycle","content":"Disable a shard without removing it in `brok.yml`:","locale":"en"},"352":{"id":"/docs/shards-20","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"| Field  | Required | Rules                                             |\n| ------ | -------- | ------------------------------------------------- |\n| `name` | ✓        | `^[a-z][a-z0-9-]{1,63}$`, unique in the workspace |","locale":"en","table":"table-0"},"353":{"id":"/docs/shards-21","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"| Field     | Required | Rules  |\n| --------- | -------- | ------ |\n| `version` | ✓        | SemVer |","locale":"en","table":"table-0"},"354":{"id":"/docs/shards-22","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"| Field        | Required | Rules                                                                   |\n| ------------ | -------- | ----------------------------------------------------------------------- |\n| `entrypoint` | ✓¹       | Relative path inside the shard directory; `.exe` is appended on Windows |","locale":"en","table":"table-0"},"355":{"id":"/docs/shards-23","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"| Field    | Required | Rules                                                        |\n| -------- | -------- | ------------------------------------------------------------ |\n| `skills` | ✓¹       | Directories whose subfolders each hold a `SKILL.md` (skills) |","locale":"en","table":"table-0"},"356":{"id":"/docs/shards-24","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"| Field  | Required | Rules                                     |\n| ------ | -------- | ----------------------------------------- |\n| `brok` |          | SemVer requirement on the runtime version |","locale":"en","table":"table-0"},"357":{"id":"/docs/shards-25","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"| Field     | Required | Rules              |\n| --------- | -------- | ------------------ |\n| `runtime` |          | `native` (default) |","locale":"en","table":"table-0"},"358":{"id":"/docs/shards-26","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"| Field                               | Required | Rules                                                |\n| ----------------------------------- | -------- | ---------------------------------------------------- |\n| `permissions.filesystem.read/write` |          | Workspace relative paths, no `..`, no absolute paths |","locale":"en","table":"table-0"},"359":{"id":"/docs/shards-27","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"| Field                 | Required | Rules              |\n| --------------------- | -------- | ------------------ |\n| `permissions.network` |          | `false` by default |","locale":"en","table":"table-0"},"360":{"id":"/docs/shards-28","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"| Field                 | Required | Rules                                       |\n| --------------------- | -------- | ------------------------------------------- |\n| `permissions.process` |          | Bare program names the shard intends to run |","locale":"en","table":"table-0"},"361":{"id":"/docs/shards-29","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"| Field             | Required | Rules                                                                                  |\n| ----------------- | -------- | -------------------------------------------------------------------------------------- |\n| `permissions.env` |          | Variables to pass through: exact names, `PREFIX_*` or `*_SUFFIX`. `BROK_*` is reserved |","locale":"en","table":"table-0"},"362":{"id":"/docs/shards-30","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"| Field                            | Required | Rules                                                            |\n| -------------------------------- | -------- | ---------------------------------------------------------------- |\n| `subscribes_to` / `publishes_to` |          | Topic patterns; publishing to `system:*` (or `*`) is not allowed |","locale":"en","table":"table-0"},"363":{"id":"/docs/shards-31","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"| Field           | Required | Rules                                             |\n| --------------- | -------- | ------------------------------------------------- |\n| `build.command` |          | Program + arguments, executed **without a shell** |","locale":"en","table":"table-0"},"364":{"id":"/docs/shards-32","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"| Field                  | Required | Rules                                                                                                                              |\n| ---------------------- | -------- | ---------------------------------------------------------------------------------------------------------------------------------- |\n| `releases.<os>-<arch>` |          | `https://` URL and 64 hex SHA-256; keys use Rust's `std::env::consts` names (`linux-x86_64`, `macos-aarch64`, `windows-x86_64`, …) |","locale":"en","table":"table-0"},"365":{"id":"/docs/shards-33","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"¹ A shard needs an `entrypoint`, `skills`, or both. Skill-only shards run no\nprocess, so they cannot declare topics, `build` or `releases`.","locale":"en"},"366":{"id":"/docs/shards-34","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#shardjson","content":"Unknown fields are rejected, and all violations are reported at once.","locale":"en"},"367":{"id":"/docs/shards-35","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#topics","content":"`namespace:name`, lowercase letters, digits, `-`, `_` and `.` for sub-topics:\n`file:changed`, `agent:ask.chunk`. Patterns are exact topics or a prefix\nending in `*` (`agent:ask.*`, `file:*`, `*`). Pick a namespace named after\nyour shard for your own events. The well-known topics and their payloads are\nlisted in Architecture.","locale":"en"},"368":{"id":"/docs/shards-36","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#runtime-contract","content":"`brok run` starts the entrypoint with:","locale":"en"},"369":{"id":"/docs/shards-37","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#runtime-contract","content":"working directory = workspace root;","locale":"en"},"370":{"id":"/docs/shards-38","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#runtime-contract","content":"an environment containing only OS basics (`PATH`, `HOME`, `TEMP`, …),\n`RUST_LOG`, the variables allowed by `permissions.env`, and:","locale":"en"},"371":{"id":"/docs/shards-39","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#runtime-contract","content":"| Variable        | Value                              |\n| --------------- | ---------------------------------- |\n| `BROK_ENDPOINT` | Socket path / pipe name of the bus |","locale":"en","table":"table-1"},"372":{"id":"/docs/shards-40","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#runtime-contract","content":"| Variable     | Value                              |\n| ------------ | ---------------------------------- |\n| `BROK_TOKEN` | The shard's session token (secret) |","locale":"en","table":"table-1"},"373":{"id":"/docs/shards-41","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#runtime-contract","content":"| Variable          | Value         |\n| ----------------- | ------------- |\n| `BROK_SHARD_NAME` | Manifest name |","locale":"en","table":"table-1"},"374":{"id":"/docs/shards-42","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#runtime-contract","content":"| Variable         | Value                   |\n| ---------------- | ----------------------- |\n| `BROK_WORKSPACE` | Absolute workspace root |","locale":"en","table":"table-1"},"375":{"id":"/docs/shards-43","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#runtime-contract","content":"| Variable                         | Value                         |\n| -------------------------------- | ----------------------------- |\n| `BROK_FS_READ` / `BROK_FS_WRITE` | Declared paths, `;`-separated |","locale":"en","table":"table-1"},"376":{"id":"/docs/shards-44","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#runtime-contract","content":"| Variable       | Value      |\n| -------------- | ---------- |\n| `BROK_NETWORK` | `1` or `0` |","locale":"en","table":"table-1"},"377":{"id":"/docs/shards-45","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#runtime-contract","content":"stdout and stderr are captured line by line, prefixed with the shard name in\nthe `brok run` output and appended to `.brokspace/logs/<name>.log`. Log to\nstderr.","locale":"en"},"378":{"id":"/docs/shards-46","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#runtime-contract","content":"On `system:shutdown` (delivered without subscribing), exit within 3 seconds.","locale":"en"},"379":{"id":"/docs/shards-47","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#runtime-contract","content":"A non-zero exit is a crash: the shard is restarted with backoff.","locale":"en"},"380":{"id":"/docs/shards-48","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#using-the-sdk","content":"Typed payloads implement `brok_sdk::Payload` (a serde type plus its topic).","locale":"en"},"381":{"id":"/docs/shards-49","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#using-the-sdk","content":"`client.request(event)` returns a stream of replies; `client.call::<Req,\nRes>(&req, timeout)` waits for the first typed reply. Example: query the\nindex with `client.call::<SearchRequest, SearchResults>(…)` (add\n`index:search` to `publishes_to`).","locale":"en"},"382":{"id":"/docs/shards-50","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#using-the-sdk","content":"`client.reply(&request, &payload)` answers a request; only the requester\nreceives it.","locale":"en"},"383":{"id":"/docs/shards-51","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#using-the-sdk","content":"`client.context()` returns the workspace root, your `shards.<name>.settings`\nfrom `brok.yml` and the `llm` routing table.","locale":"en"},"384":{"id":"/docs/shards-52","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#using-the-sdk","content":"Shards do not have to be written in Rust: anything that can open a Unix\nsocket / named pipe and exchange length-prefixed JSON frames works. The frame\nformat is documented in `brok-sdk/src/frame.rs` and `codec.rs`.","locale":"en"},"385":{"id":"/docs/shards-53","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#security","content":"What the runtime **enforces**: topic ACLs, `source` stamping, reply routing,\nthe scrubbed environment, the working directory.","locale":"en"},"386":{"id":"/docs/shards-54","page_id":"/docs/shards","tags":[],"type":"text","url":"/docs/shards#security","content":"What is **declared but not yet enforced by the OS**: file system and network\naccess. Consent at install time is the safeguard until OS sandboxes (Landlock,\nSeatbelt, AppContainer) land. `build.command` runs arbitrary code from the\nshard repository (e.g. `build.rs`) — the consent prompt shows it before it\nruns. Prefer shards that publish checksum-pinned `releases`.","locale":"en"},"387":{"id":"/docs/skills","page_id":"/docs/skills","type":"page","content":"Skills","breadcrumbs":["Brokspace","Guides"],"tags":[],"url":"/docs/skills","locale":"en"},"388":{"id":"/docs/skills-0","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills","content":"A skill is a small, reusable workflow written for AI agents: a folder with a SKILL.md (YAML frontmatter name + description, then instructions) and optional reference files.","locale":"en"},"389":{"id":"/docs/skills-1","page_id":"/docs/skills","type":"heading","tags":[],"url":"/docs/skills#two-kinds","content":"Two kinds","locale":"en"},"390":{"id":"/docs/skills-2","page_id":"/docs/skills","type":"heading","tags":[],"url":"/docs/skills#built-in-skills","content":"Built-in skills","locale":"en"},"391":{"id":"/docs/skills-3","page_id":"/docs/skills","type":"heading","tags":[],"url":"/docs/skills#using-skills","content":"Using skills","locale":"en"},"392":{"id":"/docs/skills-4","page_id":"/docs/skills","type":"heading","tags":[],"url":"/docs/skills#writing-your-own","content":"Writing your own","locale":"en"},"393":{"id":"/docs/skills-5","page_id":"/docs/skills","type":"heading","tags":[],"url":"/docs/skills#sharing-skills-skill-shards","content":"Sharing skills: skill shards","locale":"en"},"394":{"id":"/docs/skills-6","page_id":"/docs/skills","type":"heading","tags":[],"url":"/docs/skills#precedence","content":"Precedence","locale":"en"},"395":{"id":"/docs/skills-7","page_id":"/docs/skills","type":"heading","tags":[],"url":"/docs/skills#credits","content":"Credits","locale":"en"},"396":{"id":"/docs/skills-8","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills","content":"A **skill** is a small, reusable workflow written for AI agents: a folder\nwith a `SKILL.md` (YAML frontmatter `name` + `description`, then\ninstructions) and optional reference files. Brokspace uses the same\nAgent Skills format as Claude Code,\nCodex, Cursor and GitHub Copilot, so a skill written once works everywhere.","locale":"en"},"397":{"id":"/docs/skills-9","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#two-kinds","content":"|               | User-invoked                | Model-invoked                        |\n| ------------- | --------------------------- | ------------------------------------ |\n| Who starts it | Only you, by typing `/name` | You, or the agent when the task fits |","locale":"en","table":"table-0"},"398":{"id":"/docs/skills-10","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#two-kinds","content":"|             | User-invoked                     | Model-invoked |\n| ----------- | -------------------------------- | ------------- |\n| Frontmatter | `disable-model-invocation: true` | (default)     |","locale":"en","table":"table-0"},"399":{"id":"/docs/skills-11","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#two-kinds","content":"|      | User-invoked                                | Model-invoked                                |\n| ---- | ------------------------------------------- | -------------------------------------------- |\n| Role | Orchestrates a flow (`/to-spec`, `/triage`) | A reusable discipline (`tdd`, `code-review`) |","locale":"en","table":"table-0"},"400":{"id":"/docs/skills-12","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#two-kinds","content":"|             | User-invoked          | Model-invoked               |\n| ----------- | --------------------- | --------------------------- |\n| Description | One human-facing line | Rich \"Use when...\" triggers |","locale":"en","table":"table-0"},"401":{"id":"/docs/skills-13","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#built-in-skills","content":"`brok` ships a curated set, embedded in the binary (source:\nskills/). They cover the whole development loop that\nBrokspace itself uses: align, specify, slice, build test-first, review, ship.","locale":"en"},"402":{"id":"/docs/skills-14","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#built-in-skills","content":"Not sure where to start? Type `/ask-brok` in your coding agent and describe\nyour situation.","locale":"en"},"403":{"id":"/docs/skills-15","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#using-skills","content":"**In your coding agent** (the main way):","locale":"en"},"404":{"id":"/docs/skills-16","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#using-skills","content":"Skills land in `.claude/skills/` and the portable `.agents/skills/` (read by\nCodex, Cursor, Copilot and others). Folders are marked `.brokspace-managed`\nand refreshed on every export; brok never overwrites a folder it did not\ncreate. Commit them to share with your team.","locale":"en"},"405":{"id":"/docs/skills-17","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#using-skills","content":"**On your local LLM**, through `brok-agent` (needs `brok run`):","locale":"en"},"406":{"id":"/docs/skills-18","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#using-skills","content":"The skill's instructions (and the reference files it links) become the\nsystem prompt; Brokspace adds relevant code from the index as context.","locale":"en"},"407":{"id":"/docs/skills-19","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#writing-your-own","content":"Workspace skills in `.brokspace/skills/<name>/` **override** built-ins with\nthe same name, so you can tailor any built-in to your team. Keep skills\nshort and explicit: small local models follow them too. The built-in\n`write-skill` skill walks your agent through it.","locale":"en"},"408":{"id":"/docs/skills-20","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#sharing-skills-skill-shards","content":"A **skill shard** is a shard with no process, just skills. Publish it as a\ngit repository and anyone can install it:","locale":"en"},"409":{"id":"/docs/skills-21","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#sharing-skills-skill-shards","content":"`shard.json` of a skill shard:","locale":"en"},"410":{"id":"/docs/skills-22","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#sharing-skills-skill-shards","content":"A shard can also ship skills next to its process (`entrypoint` + `skills`).","locale":"en"},"411":{"id":"/docs/skills-23","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#precedence","content":"When names collide, the first wins: workspace (`.brokspace/skills/`) >\ninstalled shards > built-in. `brok skill list` reports shadowed skills.","locale":"en"},"412":{"id":"/docs/skills-24","page_id":"/docs/skills","tags":[],"type":"text","url":"/docs/skills#credits","content":"The built-in workflows are adapted from\nmattpocock/skills (MIT); see\nskills/CREDITS.md.","locale":"en"},"413":{"id":"/pt-br/docs/architecture","page_id":"/pt-br/docs/architecture","type":"page","content":"Architecture","breadcrumbs":["Brokspace","Referência"],"tags":[],"url":"/pt-br/docs/architecture","locale":"pt-br"},"414":{"id":"/pt-br/docs/architecture-0","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture","content":"This document explains how the pieces of Brokspace fit together.","locale":"pt-br"},"415":{"id":"/pt-br/docs/architecture-1","page_id":"/pt-br/docs/architecture","type":"heading","tags":[],"url":"/pt-br/docs/architecture#crates-and-repositories","content":"Crates and repositories","locale":"pt-br"},"416":{"id":"/pt-br/docs/architecture-2","page_id":"/pt-br/docs/architecture","type":"heading","tags":[],"url":"/pt-br/docs/architecture#workspace-layout","content":"Workspace layout","locale":"pt-br"},"417":{"id":"/pt-br/docs/architecture-3","page_id":"/pt-br/docs/architecture","type":"heading","tags":[],"url":"/pt-br/docs/architecture#indexing-pipeline","content":"Indexing pipeline","locale":"pt-br"},"418":{"id":"/pt-br/docs/architecture-4","page_id":"/pt-br/docs/architecture","type":"heading","tags":[],"url":"/pt-br/docs/architecture#stores","content":"Stores","locale":"pt-br"},"419":{"id":"/pt-br/docs/architecture-5","page_id":"/pt-br/docs/architecture","type":"heading","tags":[],"url":"/pt-br/docs/architecture#search","content":"Search","locale":"pt-br"},"420":{"id":"/pt-br/docs/architecture-6","page_id":"/pt-br/docs/architecture","type":"heading","tags":[],"url":"/pt-br/docs/architecture#event-bus","content":"Event bus","locale":"pt-br"},"421":{"id":"/pt-br/docs/architecture-7","page_id":"/pt-br/docs/architecture","type":"heading","tags":[],"url":"/pt-br/docs/architecture#built-in-participants","content":"Built-in participants","locale":"pt-br"},"422":{"id":"/pt-br/docs/architecture-8","page_id":"/pt-br/docs/architecture","type":"heading","tags":[],"url":"/pt-br/docs/architecture#well-known-topics","content":"Well-known topics","locale":"pt-br"},"423":{"id":"/pt-br/docs/architecture-9","page_id":"/pt-br/docs/architecture","type":"heading","tags":[],"url":"/pt-br/docs/architecture#daemon-lifecycle","content":"Daemon lifecycle","locale":"pt-br"},"424":{"id":"/pt-br/docs/architecture-10","page_id":"/pt-br/docs/architecture","type":"heading","tags":[],"url":"/pt-br/docs/architecture#memory-profile","content":"Memory profile","locale":"pt-br"},"425":{"id":"/pt-br/docs/architecture-11","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture","content":"This document explains how the pieces of Brokspace fit together. It is aimed\nat contributors and shard authors.","locale":"pt-br"},"426":{"id":"/pt-br/docs/architecture-12","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#crates-and-repositories","content":"Rules of thumb: library crates use `thiserror`/`anyhow::Result` with context\nand never print; only `brok-cli` talks to the terminal. Optional native\nbackends are cargo features, so the pure-Rust build always works.","locale":"pt-br"},"427":{"id":"/pt-br/docs/architecture-13","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#indexing-pipeline","content":"**Walk** with the `ignore` crate (nested `.gitignore`s, global excludes),\nthen apply `index.include` / `index.exclude`.","locale":"pt-br"},"428":{"id":"/pt-br/docs/architecture-14","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#indexing-pipeline","content":"**Route** each file to the deepest partition containing it\n(`PartitionMap::resolve`).","locale":"pt-br"},"429":{"id":"/pt-br/docs/architecture-15","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#indexing-pipeline","content":"**Skip unchanged files** cheaply: same size and mtime as in `files.json` →\nuntouched; otherwise hash the content and compare.","locale":"pt-br"},"430":{"id":"/pt-br/docs/architecture-16","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#indexing-pipeline","content":"**Chunk** in parallel (rayon). The AST chunker emits one chunk per\ndefinition, attaches doc comments/attributes/decorators, splits large\ncontainers into a header plus members (`parent` = the container) and\ngroups loose top-level code into `preamble` chunks.","locale":"pt-br"},"431":{"id":"/pt-br/docs/architecture-17","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#indexing-pipeline","content":"**Embed** in batches on a blocking thread (`spawn_blocking`), prefixing\n`search_document:` as nomic models expect; mean pooling → layer norm →\nMatryoshka truncation → L2 normalization.","locale":"pt-br"},"432":{"id":"/pt-br/docs/architecture-18","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#indexing-pipeline","content":"**Write**: delete the file's previous chunks, append the new ones, update\nBM25 and the manifest, then commit atomically. Files are processed in\nbatches of 512 so memory stays bounded on large repositories.","locale":"pt-br"},"433":{"id":"/pt-br/docs/architecture-19","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#indexing-pipeline","content":"`brok index` and `brok run` take an exclusive OS file lock on\n`databases/.lock`; readers (`brok search`, `brok status`) never block.","locale":"pt-br"},"434":{"id":"/pt-br/docs/architecture-20","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#stores","content":"Both stores share one Arrow schema (`brok-index/src/schema.rs`): `id`, `path`,\n`language`, `kind`, `symbol`, `parent`, `signature`, line and byte ranges,\n`file_hash`, `content` and an optional `FixedSizeList<Float32>` `vector`.","locale":"pt-br"},"435":{"id":"/pt-br/docs/architecture-21","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#stores","content":"**LanceDB**: deletes/appends go straight to the table; compaction runs every\n16 writes and an ANN index is built past 10 000 rows.","locale":"pt-br"},"436":{"id":"/pt-br/docs/architecture-22","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#stores","content":"**Arrow IPC**: each commit writes a new immutable generation file and flips\n`CURRENT`. Files are memory-mapped and decoded zero-copy; immutability is\nwhat makes `mmap` sound and lets readers keep an old generation (Windows\ncannot replace a mapped file). Vector search is exact (dot product over\nnormalized vectors).","locale":"pt-br"},"437":{"id":"/pt-br/docs/architecture-23","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#search","content":"For each partition: BM25 top-k and vector top-k (when the partition has\nvectors of the right size) → Reciprocal Rank Fusion (`k = 60`), normalized so\nthat rank 1 in every list scores 1.0. Partitions other than the focus (the\npartition of the current directory) are multiplied by `search.cold_weight`.\nThe final top-k chunk ids are materialized from their stores.","locale":"pt-br"},"438":{"id":"/pt-br/docs/architecture-24","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#event-bus","content":"**Transport**: Unix domain socket at `.brokspace/run/brok.sock` (falls back\nto `$XDG_RUNTIME_DIR` for long paths) or the named pipe\n`\\\\.\\pipe\\brok-<hash of the workspace path>`. Frames are a 4-byte big-endian\nlength plus JSON, capped at 16 MiB.","locale":"pt-br"},"439":{"id":"/pt-br/docs/architecture-25","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#event-bus","content":"**Handshake**: `Hello{protocol, name, version, token}` → `Welcome{session,\nidentity, context}` or `Error`. Tokens are 256-bit random, stored hashed.","locale":"pt-br"},"440":{"id":"/pt-br/docs/architecture-26","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#event-bus","content":"**Router**: a single actor task owns all state, so routing is lock-free.\nDelivery uses bounded queues and `try_send`: a slow client loses events (and\nis logged) rather than stalling everyone.","locale":"pt-br"},"441":{"id":"/pt-br/docs/architecture-27","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#event-bus","content":"**Semantics**: topic patterns (`file:*`), `source` stamped by the bus,\n`system:*` reserved and broadcast, request/reply via `correlation_id` routed\nonly to the requester (a bounded table with a 15 minute TTL).","locale":"pt-br"},"442":{"id":"/pt-br/docs/architecture-28","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#built-in-participants","content":"| Participant                                 | Identity   | Publishes            | Subscribes |\n| ------------------------------------------- | ---------- | -------------------- | ---------- |\n| CLI (`brok ask`, `brok bus`, `brok search`) | `operator` | any non-system topic | `*`        |","locale":"pt-br","table":"table-0"},"443":{"id":"/pt-br/docs/architecture-29","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#built-in-participants","content":"| Participant   | Identity     | Publishes | Subscribes                     |\n| ------------- | ------------ | --------- | ------------------------------ |\n| Index service | `brok-index` | `index:*` | `file:changed`, `index:search` |","locale":"pt-br","table":"table-0"},"444":{"id":"/pt-br/docs/architecture-30","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#built-in-participants","content":"| Participant | Identity            | Publishes      | Subscribes      |\n| ----------- | ------------------- | -------------- | --------------- |\n| Shards      | their manifest name | `publishes_to` | `subscribes_to` |","locale":"pt-br","table":"table-0"},"445":{"id":"/pt-br/docs/architecture-31","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#well-known-topics","content":"| Topic          | Payload                              | Direction                  |\n| -------------- | ------------------------------------ | -------------------------- |\n| `file:changed` | `{changed: [path], deleted: [path]}` | agent → index (and anyone) |","locale":"pt-br","table":"table-1"},"446":{"id":"/pt-br/docs/architecture-32","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#well-known-topics","content":"| Topic                                  | Payload                           | Direction     |\n| -------------------------------------- | --------------------------------- | ------------- |\n| `index:search` / `index:search.result` | `SearchRequest` / `SearchResults` | request/reply |","locale":"pt-br","table":"table-1"},"447":{"id":"/pt-br/docs/architecture-33","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#well-known-topics","content":"| Topic           | Payload             | Direction      |\n| --------------- | ------------------- | -------------- |\n| `index:updated` | counts and duration | index → anyone |","locale":"pt-br","table":"table-1"},"448":{"id":"/pt-br/docs/architecture-34","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#well-known-topics","content":"| Topic       | Payload                                | Direction   |\n| ----------- | -------------------------------------- | ----------- |\n| `agent:ask` | `{prompt, provider?, context_chunks?}` | CLI → agent |","locale":"pt-br","table":"table-1"},"449":{"id":"/pt-br/docs/architecture-35","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#well-known-topics","content":"| Topic                                  | Payload        | Direction         |\n| -------------------------------------- | -------------- | ----------------- |\n| `agent:ask.chunk` / `.done` / `.error` | streamed reply | agent → requester |","locale":"pt-br","table":"table-1"},"450":{"id":"/pt-br/docs/architecture-36","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#well-known-topics","content":"| Topic           | Payload                    | Direction      |\n| --------------- | -------------------------- | -------------- |\n| `review:result` | `{path, verdict, summary}` | agent → anyone |","locale":"pt-br","table":"table-1"},"451":{"id":"/pt-br/docs/architecture-37","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#well-known-topics","content":"| Topic             | Payload    | Direction          |\n| ----------------- | ---------- | ------------------ |\n| `system:shutdown` | `{reason}` | runtime → everyone |","locale":"pt-br","table":"table-1"},"452":{"id":"/pt-br/docs/architecture-38","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#well-known-topics","content":"Types live in `brok_sdk::payload`.","locale":"pt-br"},"453":{"id":"/pt-br/docs/architecture-39","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#daemon-lifecycle","content":"`brok run` is the daemon in the foreground; `brok start` launches the same\nprocess detached (output in `.brokspace/logs/brok.log`), and `brok ask`,\n`chat`, `review`, `commit` and `skill run` start it on demand. Readiness means\nthe bus is listening and, when installed, `brok-agent` is connected; the CLI\nchecks it with a `daemon:status` request.","locale":"pt-br"},"454":{"id":"/pt-br/docs/architecture-40","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#daemon-lifecycle","content":"Start: bind the bus → issue the operator token (`run/operator.token`) → start\nthe control service (`daemon:status`, `daemon:stop`) → open the index for\nwriting (falls back to read-only search if the model or lock is unavailable),\ncatch up on changes made while stopped, and connect the index service → for\neach enabled shard, issue a token from its manifest, build its sandbox\nenvironment and supervise it.","locale":"pt-br"},"455":{"id":"/pt-br/docs/architecture-41","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#daemon-lifecycle","content":"Stop (Ctrl+C, or `brok stop` publishing `daemon:stop`): broadcast\n`system:shutdown` → shards get 3 seconds to exit, then are killed → index\nservice stops → bus stops → runtime files removed.","locale":"pt-br"},"456":{"id":"/pt-br/docs/architecture-42","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#daemon-lifecycle","content":"Freshness: `brok-agent` reports dirty files every few seconds and, when a\nrepository's `HEAD` moves (commit, pull, checkout), the files that differ\nbetween the two commits; root, submodules and nested repositories alike.","locale":"pt-br"},"457":{"id":"/pt-br/docs/architecture-43","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#daemon-lifecycle","content":"Crashing shards restart with exponential backoff (1 s … 30 s); five crashes\nwithin a minute and the supervisor gives up.","locale":"pt-br"},"458":{"id":"/pt-br/docs/architecture-44","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#memory-profile","content":"Text-only search (embeddings disabled or model missing): BM25 postings in\nmemory plus memory-mapped chunk data; typically a few tens of MB.","locale":"pt-br"},"459":{"id":"/pt-br/docs/architecture-45","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#memory-profile","content":"Semantic search loads the quantized model (~140 MB of weights) once per\nprocess. Run `brok run` and searches reuse its already-loaded model through\nthe bus instead of loading their own.","locale":"pt-br"},"460":{"id":"/pt-br/docs/architecture-46","page_id":"/pt-br/docs/architecture","tags":[],"type":"text","url":"/pt-br/docs/architecture#memory-profile","content":"Indexing streams files in batches; the Arrow store keeps staged batches in\nmemory until commit, LanceDB writes per batch.","locale":"pt-br"},"461":{"id":"/pt-br/docs/configuration","page_id":"/pt-br/docs/configuration","type":"page","content":"Configuration reference","breadcrumbs":["Brokspace","Referência"],"tags":[],"url":"/pt-br/docs/configuration","locale":"pt-br"},"462":{"id":"/pt-br/docs/configuration-0","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration","content":"Changes take effect on the next command (or after restarting brok run).","locale":"pt-br"},"463":{"id":"/pt-br/docs/configuration-1","page_id":"/pt-br/docs/configuration","type":"heading","tags":[],"url":"/pt-br/docs/configuration#workspace","content":"`workspace`","locale":"pt-br"},"464":{"id":"/pt-br/docs/configuration-2","page_id":"/pt-br/docs/configuration","type":"heading","tags":[],"url":"/pt-br/docs/configuration#index","content":"`index`","locale":"pt-br"},"465":{"id":"/pt-br/docs/configuration-3","page_id":"/pt-br/docs/configuration","type":"heading","tags":[],"url":"/pt-br/docs/configuration#embeddings","content":"`embeddings`","locale":"pt-br"},"466":{"id":"/pt-br/docs/configuration-4","page_id":"/pt-br/docs/configuration","type":"heading","tags":[],"url":"/pt-br/docs/configuration#user-defaults","content":"User defaults","locale":"pt-br"},"467":{"id":"/pt-br/docs/configuration-5","page_id":"/pt-br/docs/configuration","type":"heading","tags":[],"url":"/pt-br/docs/configuration#search","content":"`search`","locale":"pt-br"},"468":{"id":"/pt-br/docs/configuration-6","page_id":"/pt-br/docs/configuration","type":"heading","tags":[],"url":"/pt-br/docs/configuration#llm","content":"`llm`","locale":"pt-br"},"469":{"id":"/pt-br/docs/configuration-7","page_id":"/pt-br/docs/configuration","type":"heading","tags":[],"url":"/pt-br/docs/configuration#sync","content":"`sync`","locale":"pt-br"},"470":{"id":"/pt-br/docs/configuration-8","page_id":"/pt-br/docs/configuration","type":"heading","tags":[],"url":"/pt-br/docs/configuration#shards","content":"`shards`","locale":"pt-br"},"471":{"id":"/pt-br/docs/configuration-9","page_id":"/pt-br/docs/configuration","type":"heading","tags":[],"url":"/pt-br/docs/configuration#environment-variables","content":"Environment variables","locale":"pt-br"},"472":{"id":"/pt-br/docs/configuration-10","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration","content":"`brok init` writes `.brokspace/brok.yml` with comments (commands that change\nthe file, like `brok setup llm`, keep them; comments you add yourself are\ndropped when brok rewrites the file). Every key is optional;\nmissing keys take the defaults below. Unknown keys are rejected with a\n\"did you mean\" style error, so typos never go unnoticed.","locale":"pt-br"},"473":{"id":"/pt-br/docs/configuration-11","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration","content":"Changes take effect on the next command (or after restarting `brok run`).\nChanging `embeddings.model`, `embeddings.dimensions` or `index.store`\ntriggers a rebuild of the affected partitions on the next `brok index`.","locale":"pt-br"},"474":{"id":"/pt-br/docs/configuration-12","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#workspace","content":"| Key          | Default | Description                                                                                                                                 |\n| ------------ | ------- | ------------------------------------------------------------------------------------------------------------------------------------------- |\n| `submodules` | `true`  | Index git submodules and git repositories nested in the workspace (up to 4 levels, e.g. a folder of repos) as independent _hot_ partitions. |","locale":"pt-br","table":"table-0"},"475":{"id":"/pt-br/docs/configuration-13","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#index","content":"| Key       | Default    | Description                                               |\n| --------- | ---------- | --------------------------------------------------------- |\n| `include` | `[\"**/*\"]` | Globs (relative to the workspace root) of files to index. |","locale":"pt-br","table":"table-1"},"476":{"id":"/pt-br/docs/configuration-14","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#index","content":"| Key       | Default                                                                                                                                                                    | Description                                                          |\n| --------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | -------------------------------------------------------------------- |\n| `exclude` | `.git`, `.brokspace`, `target`, `node_modules`, `dist`, `build`, lock files (`*.lock`, `pnpm-lock.yaml`, `package-lock.json`, `npm-shrinkwrap.json`, `go.sum`), `*.min.js` | Globs to skip. `.gitignore` files are always honored on top of this. |","locale":"pt-br","table":"table-1"},"477":{"id":"/pt-br/docs/configuration-15","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#index","content":"| Key           | Default | Description                                                                                |\n| ------------- | ------- | ------------------------------------------------------------------------------------------ |\n| `max_file_kb` | `512`   | Larger files are skipped. Binary files (NUL bytes) and non UTF-8 files are always skipped. |","locale":"pt-br","table":"table-1"},"478":{"id":"/pt-br/docs/configuration-16","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#index","content":"| Key               | Default | Description                                                                                          |\n| ----------------- | ------- | ---------------------------------------------------------------------------------------------------- |\n| `max_chunk_lines` | `120`   | A syntactic unit longer than this is split: containers into members, other nodes at line boundaries. |","locale":"pt-br","table":"table-1"},"479":{"id":"/pt-br/docs/configuration-17","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#index","content":"| Key     | Default | Description                                                                                             |\n| ------- | ------- | ------------------------------------------------------------------------------------------------------- |\n| `store` | `auto`  | `auto` (LanceDB when compiled in), `lancedb` or `arrow` (memory-mapped Arrow IPC, exact vector search). |","locale":"pt-br","table":"table-1"},"480":{"id":"/pt-br/docs/configuration-18","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#embeddings","content":"| Key       | Default | Description                                                         |\n| --------- | ------- | ------------------------------------------------------------------- |\n| `enabled` | `true`  | `false` runs on BM25 text search only: no download, minimal memory. |","locale":"pt-br","table":"table-2"},"481":{"id":"/pt-br/docs/configuration-19","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#embeddings","content":"| Key     | Default                 | Description                     |\n| ------- | ----------------------- | ------------------------------- |\n| `model` | `nomic-embed-text-v1.5` | The only supported model today. |","locale":"pt-br","table":"table-2"},"482":{"id":"/pt-br/docs/configuration-20","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#embeddings","content":"| Key       | Default     | Description                                            |\n| --------- | ----------- | ------------------------------------------------------ |\n| `variant` | `quantized` | `quantized` (~140 MB, int8) or `full` (~550 MB, fp32). |","locale":"pt-br","table":"table-2"},"483":{"id":"/pt-br/docs/configuration-21","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#embeddings","content":"| Key          | Default | Description                                                |\n| ------------ | ------- | ---------------------------------------------------------- |\n| `dimensions` | `768`   | Matryoshka truncation: `64`, `128`, `256`, `512` or `768`. |","locale":"pt-br","table":"table-2"},"484":{"id":"/pt-br/docs/configuration-22","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#embeddings","content":"| Key      | Default | Description                                                                                |\n| -------- | ------- | ------------------------------------------------------------------------------------------ |\n| `device` | `auto`  | `auto`, `cpu`, `cuda`, `coreml`, `directml` (GPU devices need the matching build feature). |","locale":"pt-br","table":"table-2"},"485":{"id":"/pt-br/docs/configuration-23","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#embeddings","content":"| Key          | Default | Description                |\n| ------------ | ------- | -------------------------- |\n| `batch_size` | `16`    | Texts per inference batch. |","locale":"pt-br","table":"table-2"},"486":{"id":"/pt-br/docs/configuration-24","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#embeddings","content":"Model files are downloaded once per user and shared by every workspace:\n`~/.cache/brokspace/models` (Linux), `~/Library/Caches/brokspace/models`\n(macOS), `%LOCALAPPDATA%\\brokspace\\models` (Windows). Set `BROK_MODELS_DIR`\nto use another directory. A copy inside `.brokspace/cache/models/` (from\nolder versions) keeps working.","locale":"pt-br"},"487":{"id":"/pt-br/docs/configuration-25","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#user-defaults","content":"`brok setup llm` also stores your LLM choice in the user configuration\n(`~/.config/brokspace/config.yml`, `~/Library/Application Support/brokspace/`\nor `%APPDATA%\\brokspace\\`; override with `BROK_CONFIG_DIR`). `brok init`\napplies it to every new workspace, so you choose a model once per machine.","locale":"pt-br"},"488":{"id":"/pt-br/docs/configuration-26","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#search","content":"| Key     | Default | Description                |\n| ------- | ------- | -------------------------- |\n| `limit` | `8`     | Default number of results. |","locale":"pt-br","table":"table-3"},"489":{"id":"/pt-br/docs/configuration-27","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#search","content":"| Key           | Default | Description                                                                  |\n| ------------- | ------- | ---------------------------------------------------------------------------- |\n| `cold_weight` | `0.85`  | Score multiplier for partitions other than the one you run the command from. |","locale":"pt-br","table":"table-3"},"490":{"id":"/pt-br/docs/configuration-28","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#llm","content":"OpenAI-compatible chat completion endpoints used by `brok-agent`.","locale":"pt-br"},"491":{"id":"/pt-br/docs/configuration-29","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#llm","content":"| Key       | Description                                                                           |\n| --------- | ------------------------------------------------------------------------------------- |\n| `default` | Provider used unless `brok ask --provider` says otherwise. Must exist in `providers`. |","locale":"pt-br","table":"table-4"},"492":{"id":"/pt-br/docs/configuration-30","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#llm","content":"| Key                         | Description                    |\n| --------------------------- | ------------------------------ |\n| `providers.<name>.base_url` | URL up to and including `/v1`. |","locale":"pt-br","table":"table-4"},"493":{"id":"/pt-br/docs/configuration-31","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#llm","content":"| Key                      | Description                            |\n| ------------------------ | -------------------------------------- |\n| `providers.<name>.model` | Model name as the provider expects it. |","locale":"pt-br","table":"table-4"},"494":{"id":"/pt-br/docs/configuration-32","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#llm","content":"| Key                            | Description                                                                       |\n| ------------------------------ | --------------------------------------------------------------------------------- |\n| `providers.<name>.api_key_env` | **Name** of the environment variable holding the key. Keys never go in this file. |","locale":"pt-br","table":"table-4"},"495":{"id":"/pt-br/docs/configuration-33","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#llm","content":"| Key                                           | Description                 |\n| --------------------------------------------- | --------------------------- |\n| `providers.<name>.temperature` / `max_tokens` | Optional sampling settings. |","locale":"pt-br","table":"table-4"},"496":{"id":"/pt-br/docs/configuration-34","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#sync","content":"Where the index is mirrored, configured with `brok setup sync`.","locale":"pt-br"},"497":{"id":"/pt-br/docs/configuration-35","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#sync","content":"| Key       | Description                               |\n| --------- | ----------------------------------------- |\n| `backend` | `none`, `s3`, `r2`, `minio` or `git-lfs`. |","locale":"pt-br","table":"table-5"},"498":{"id":"/pt-br/docs/configuration-36","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#sync","content":"| Key                                                | Description                 |\n| -------------------------------------------------- | --------------------------- |\n| `remote.bucket` / `prefix` / `region` / `endpoint` | Object storage coordinates. |","locale":"pt-br","table":"table-5"},"499":{"id":"/pt-br/docs/configuration-37","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#sync","content":"| Key                                        | Description                                                                                             |\n| ------------------------------------------ | ------------------------------------------------------------------------------------------------------- |\n| `remote.access_key_env` / `secret_key_env` | Names of the variables holding the credentials (default `AWS_ACCESS_KEY_ID` / `AWS_SECRET_ACCESS_KEY`). |","locale":"pt-br","table":"table-5"},"500":{"id":"/pt-br/docs/configuration-38","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#sync","content":"`git-lfs` tracks `.brokspace/databases/**` with Git LFS and stops ignoring it,\nso the index travels with the repository. The object storage sync engine\n(`brok sync`) is on the roadmap: today `brok setup sync` records the target.","locale":"pt-br"},"501":{"id":"/pt-br/docs/configuration-39","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#shards","content":"Each shard documents its own `settings`. For `brok-agent` see its\nREADME.","locale":"pt-br"},"502":{"id":"/pt-br/docs/configuration-40","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#environment-variables","content":"| Variable   | Used by | Purpose                                       |\n| ---------- | ------- | --------------------------------------------- |\n| `RUST_LOG` | all     | Log filter, e.g. `RUST_LOG=brok_index=debug`. |","locale":"pt-br","table":"table-6"},"503":{"id":"/pt-br/docs/configuration-41","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#environment-variables","content":"| Variable   | Used by | Purpose         |\n| ---------- | ------- | --------------- |\n| `NO_COLOR` | CLI     | Disable colors. |","locale":"pt-br","table":"table-6"},"504":{"id":"/pt-br/docs/configuration-42","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#environment-variables","content":"| Variable          | Used by | Purpose                                                  |\n| ----------------- | ------- | -------------------------------------------------------- |\n| `BROK_MODELS_DIR` | CLI     | Embedding model cache (default: the OS cache directory). |","locale":"pt-br","table":"table-6"},"505":{"id":"/pt-br/docs/configuration-43","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#environment-variables","content":"| Variable          | Used by | Purpose                                                     |\n| ----------------- | ------- | ----------------------------------------------------------- |\n| `BROK_CONFIG_DIR` | CLI     | User defaults directory (default: the OS config directory). |","locale":"pt-br","table":"table-6"},"506":{"id":"/pt-br/docs/configuration-44","page_id":"/pt-br/docs/configuration","tags":[],"type":"text","url":"/pt-br/docs/configuration#environment-variables","content":"| Variable          | Used by | Purpose                                          |\n| ----------------- | ------- | ------------------------------------------------ |\n| `BROK_*` (others) | shards  | Set by `brok run` for shard processes; reserved. |","locale":"pt-br","table":"table-6"},"507":{"id":"/pt-br/docs/getting-started","page_id":"/pt-br/docs/getting-started","type":"page","content":"Getting started with Brokspace","breadcrumbs":["Brokspace","Início"],"tags":[],"url":"/pt-br/docs/getting-started","locale":"pt-br"},"508":{"id":"/pt-br/docs/getting-started-0","page_id":"/pt-br/docs/getting-started","tags":[],"type":"text","url":"/pt-br/docs/getting-started","content":"From zero to a productive workspace in about 15 minutes.","locale":"pt-br"},"509":{"id":"/pt-br/docs/getting-started-1","page_id":"/pt-br/docs/getting-started","type":"heading","tags":[],"url":"/pt-br/docs/getting-started#1-install-brok","content":"1. Install brok","locale":"pt-br"},"510":{"id":"/pt-br/docs/getting-started-2","page_id":"/pt-br/docs/getting-started","type":"heading","tags":[],"url":"/pt-br/docs/getting-started#2-get-a-local-llm-optional","content":"2. Get a local LLM (optional)","locale":"pt-br"},"511":{"id":"/pt-br/docs/getting-started-3","page_id":"/pt-br/docs/getting-started","type":"heading","tags":[],"url":"/pt-br/docs/getting-started#3-set-up-your-first-workspace","content":"3. Set up your first workspace","locale":"pt-br"},"512":{"id":"/pt-br/docs/getting-started-4","page_id":"/pt-br/docs/